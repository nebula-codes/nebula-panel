    <EmbeddedResource Include="OfficialGames/Minecraft/Schemas/server.properties.schema.json" />
    <EmbeddedResource Include="OfficialGames/Minecraft/Schemas/spigot.yml.schema.json" />
    <EmbeddedResource Include="OfficialGames/_Template/Schemas/example-config.schema.json" />
  </ItemGroup>

</Project>

{
  "$schema": "https://nebula-panel.dev/schemas/game-definition-v1.json",
  "schemaVersion": "1.0",
  "slug": "your-game-slug",
  "name": "Your Game Name",
  "steamAppId": "123456",
  "executableType": "Exe",
  "defaultExecutablePath": "server.exe",
  "defaultStartCommand": "server.exe -port {port} -maxplayers {maxPlayers}",
  "defaultStopCommand": "quit",
  "supportsDocker": true,
  "defaultDockerImage": "yourimage/server:latest",
  "iconPath": "/images/games/your-game.png",
  "supportsMods": false,
  "modProviders": [],
  "rconDefaults": {
    "defaultEnabled": true,
    "protocol": "Source",
    "defaultPort": 27015
  },
  "configSchemaFiles": {
    "server.cfg": "Schemas/server.cfg.schema.json"
  },
  "versionSources": [
    {
      "type": "SteamCmd",
      "url": "123456"
    }
  ],
  "installConfig": {
    "type": "SteamCmd",
    "steamAppId": "123456",
    "validateAfterInstall": true,
    "postInstallCommands": []
  }
}

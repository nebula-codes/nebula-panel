@page "/login"
@layout AuthLayout
@using NebulaPanel.Web.Services
@inject IAuthClientService AuthService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Sign In - Nebula Panel</PageTitle>

<div class="p-6">
    <div class="text-center mb-6">
        <h2 class="text-xl font-semibold text-nebula-text-primary">Welcome Back</h2>
        <p class="text-sm text-nebula-text-muted mt-1">Sign in to manage your servers</p>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="@GetErrorAlertClass() mb-4">
            <div class="flex items-start gap-3">
                <Icon Name="@GetErrorIcon()" Size="IconSize.Small" Class="mt-0.5 flex-shrink-0" />
                <div class="flex-1">
                    <span class="text-sm block">@_errorMessage</span>
                    @if (_lockoutEndTime.HasValue)
                    {
                        <span class="text-xs block mt-1 opacity-80">
                            Account unlocks at @_lockoutEndTime.Value.ToLocalTime().ToString("h:mm tt")
                        </span>
                    }
                    @if (_retryCountdown > 0)
                    {
                        <span class="text-xs block mt-1 opacity-80">
                            Try again in @_retryCountdown seconds
                        </span>
                    }
                </div>
            </div>
        </div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleLogin" FormName="login">
        <DataAnnotationsValidator />

        <div class="space-y-4">
            <div class="form-group">
                <label for="username" class="label">Username</label>
                <div class="relative">
                    <InputText id="username"
                               @bind-Value="_model.Username"
                               class="input pl-10"
                               placeholder="Enter your username"
                               disabled="@IsFormDisabled" />
                    <Icon Name="user" Size="IconSize.Small" Class="absolute left-3 top-1/2 -translate-y-1/2 text-nebula-text-muted" />
                </div>
                <ValidationMessage For="() => _model.Username" class="validation-message" />
            </div>

            <div class="form-group">
                <label for="password" class="label">Password</label>
                <div class="relative">
                    <InputText id="password"
                               @bind-Value="_model.Password"
                               type="@(_showPassword ? "text" : "password")"
                               class="input pl-10 pr-10"
                               placeholder="Enter your password"
                               disabled="@IsFormDisabled" />
                    <Icon Name="lock" Size="IconSize.Small" Class="absolute left-3 top-1/2 -translate-y-1/2 text-nebula-text-muted" />
                    <button type="button"
                            class="absolute right-3 top-1/2 -translate-y-1/2 text-nebula-text-muted hover:text-nebula-text-secondary transition-colors"
                            @onclick="TogglePassword"
                            tabindex="-1"
                            disabled="@IsFormDisabled">
                        <Icon Name="@(_showPassword ? "eye-off" : "eye")" Size="IconSize.Small" />
                    </button>
                </div>
                <ValidationMessage For="() => _model.Password" class="validation-message" />
            </div>

            <div class="flex items-center justify-between">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input type="checkbox" class="w-4 h-4 rounded bg-nebula-input-bg border-nebula-border text-nebula-accent focus:ring-nebula-accent/20" />
                    <span class="text-sm text-nebula-text-secondary">Remember me</span>
                </label>
            </div>

            <button type="submit"
                    class="btn-primary w-full justify-center"
                    disabled="@IsFormDisabled">
                @if (_isLoading)
                {
                    <span class="spinner"></span>
                    <span>Signing in...</span>
                }
                else if (_retryCountdown > 0)
                {
                    <Icon Name="clock" Size="IconSize.Small" />
                    <span>Wait @_retryCountdown seconds</span>
                }
                else
                {
                    <Icon Name="log-in" Size="IconSize.Small" />
                    <span>Sign In</span>
                }
            </button>
        </div>
    </EditForm>

</div>

@code {
    private LoginModel _model = new();
    private string? _errorMessage;
    private string? _errorCode;
    private bool _isLoading;
    private bool _showPassword;
    private int _retryCountdown;
    private DateTime? _lockoutEndTime;
    private Timer? _countdownTimer;

    private bool IsFormDisabled => _isLoading || _retryCountdown > 0;

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private void TogglePassword()
    {
        _showPassword = !_showPassword;
    }

    private async Task HandleLogin()
    {
        if (_retryCountdown > 0)
        {
            return;
        }

        _errorMessage = null;
        _errorCode = null;
        _lockoutEndTime = null;
        _isLoading = true;

        try
        {
            var result = await AuthService.LoginAsync(_model.Username, _model.Password);

            if (result.Success)
            {
                var returnUrl = string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl;
                Navigation.NavigateTo(returnUrl, forceLoad: true);
            }
            else
            {
                _errorCode = result.ErrorCode;
                _lockoutEndTime = result.LockoutEndTime;

                if (result.IsRateLimited && result.RetryAfterSeconds.HasValue)
                {
                    _errorMessage = "Too many login attempts. Please wait before trying again.";
                    StartCountdown(result.RetryAfterSeconds.Value);
                }
                else if (result.IsAccountLocked && result.LockoutEndTime.HasValue)
                {
                    _errorMessage = "Account temporarily locked due to too many failed login attempts.";
                }
                else
                {
                    _errorMessage = result.Error ?? "Login failed. Please check your credentials.";
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void StartCountdown(int seconds)
    {
        _retryCountdown = seconds;
        StopCountdown();

        _countdownTimer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                _retryCountdown--;
                if (_retryCountdown <= 0)
                {
                    StopCountdown();
                    _errorMessage = null;
                    _errorCode = null;
                }
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void StopCountdown()
    {
        _countdownTimer?.Dispose();
        _countdownTimer = null;
    }

    private string GetErrorAlertClass()
    {
        return _errorCode switch
        {
            "RateLimited" => "alert-warning",
            "AccountLocked" => "alert-warning",
            _ => "alert-error"
        };
    }

    private string GetErrorIcon()
    {
        return _errorCode switch
        {
            "RateLimited" => "clock",
            "AccountLocked" => "lock",
            _ => "alert-circle"
        };
    }

    public void Dispose()
    {
        StopCountdown();
    }

    private class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Username is required")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required")]
        public string Password { get; set; } = string.Empty;
    }
}

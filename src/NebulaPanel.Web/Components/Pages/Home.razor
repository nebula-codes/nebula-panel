                _summary = _summary with
                {
                    RunningServers = _summary.RunningServers + 1,
                    StartingOrStopping = Math.Max(0, _summary.StartingOrStopping - 1)
                };
                ToastService.ShowError(result.Error ?? "Failed to stop server");

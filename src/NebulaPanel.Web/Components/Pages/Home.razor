    private IReadOnlyList<ResourceDataPointDto> GetAggregatedResourceData()
    {
        // Aggregate all server data points by timestamp (rounded to nearest minute)
        if (_resourceHistory.Count == 0)
            return [];

        var allPoints = _resourceHistory
            .SelectMany(s => s.DataPoints)
            .GroupBy(p => new DateTime(p.Timestamp.Year, p.Timestamp.Month, p.Timestamp.Day,
                                        p.Timestamp.Hour, p.Timestamp.Minute, 0, DateTimeKind.Utc))
            .Select(g => new ResourceDataPointDto(
                Timestamp: g.Key,
                CpuPercent: g.Average(p => p.CpuPercent),
                MemoryMb: g.Sum(p => p.MemoryMb),
                PlayerCount: g.Sum(p => p.PlayerCount ?? 0)
            ))
            .OrderBy(p => p.Timestamp)
            .ToList();

        return allPoints;
    }


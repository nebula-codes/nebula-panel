    private async Task HandleTogglePin(GameServerListItemDto server)
    {
        // Optimistic update
        _servers = _servers.Select(s =>
            s.Id == server.Id ? s with { IsPinned = !s.IsPinned } : s
        ).OrderByDescending(s => s.IsPinned).ThenBy(s => s.Name).ToList();
        StateHasChanged();

        var result = await GameServerService.TogglePinAsync(server.Id);
        if (!result.IsSuccess)
        {
            // Revert on failure
            _servers = _servers.Select(s =>
                s.Id == server.Id ? s with { IsPinned = !s.IsPinned } : s
            ).OrderByDescending(s => s.IsPinned).ThenBy(s => s.Name).ToList();
            StateHasChanged();
        }
    }

    private void UpdateServerStatus(Guid serverId, ServerStatus newStatus)
    {
        var updatedServers = _servers.Select(s =>
            s.Id == serverId
                ? s with { Status = newStatus }
                : s
        ).ToList();
        _servers = updatedServers;
    }

    private void RequestStartAll()
    {
        _pendingBulkAction = "start";
        _showBulkConfirm = true;
    }

    private void RequestStopAll()
    {
        _pendingBulkAction = "stop";
        _showBulkConfirm = true;
    }

    private void CancelBulkAction()
    {
        _showBulkConfirm = false;
        _pendingBulkAction = null;
    }

    private async Task ConfirmBulkAction()
    {
        _showBulkConfirm = false;
        if (_pendingBulkAction == "start")
            await StartAllServers();
        else if (_pendingBulkAction == "stop")
            await StopAllServers();
        _pendingBulkAction = null;
    }

    private async Task StartAllServers()
    {
        if (_isLoading) return;

        _isLoading = true;
        try
        {
            var authState = await AuthStateTask!;
            var userId = Guid.Parse(authState.User.FindFirst("sub")?.Value ?? Guid.Empty.ToString());

            var result = await DashboardService.StartAllServersAsync(userId);
            if (result.IsSuccess)
            {
                ToastService.ShowSuccess("All servers are starting...");
                // SignalR will push status updates
            }
            else
            {
                ToastService.ShowError(result.Error ?? "Failed to start servers");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }


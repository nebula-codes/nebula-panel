    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private Guid GetCurrentUserId()
    {
        if (AuthState is null) return Guid.Empty;
        var state = AuthState.Result;
        var userIdClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)
            ?? state.User.FindFirst("sub");
        return userIdClaim is not null && Guid.TryParse(userIdClaim.Value, out var userId)
            ? userId
            : Guid.Empty;
    }

    // Schedule management methods
    private void ShowScheduleModal()
    {
        _scheduleDateTime = DateTime.Now.AddHours(1);
        _scheduleCreateBackup = true;
        _scheduleStopServers = true;
        _scheduleRestartServers = true;
        _showScheduleModal = true;
    }

    private void CloseScheduleModal()
    {
        _showScheduleModal = false;
    }

    private async Task ScheduleUpdate()
    {
        if (_availableRelease is null) return;

        try
        {
            _scheduling = true;
            _error = null;

            var options = new UpdateOptions
            {
                CreateBackup = _scheduleCreateBackup,
                StopGameServers = _scheduleStopServers,
                RestartGameServers = _scheduleRestartServers
            };

            var result = await ScheduleService.ScheduleUpdateAsync(
                _availableRelease.Version,
                _scheduleDateTime.ToUniversalTime(),
                options,
                GetCurrentUserId(),
                _availableRelease.Body);

            if (result.IsSuccess)
            {
                _success = $"Update to v{_availableRelease.Version} scheduled for {_scheduleDateTime:MMM d, yyyy h:mm tt}";
                _pendingSchedule = result.Value;
                CloseScheduleModal();
            }
            else
            {
                _error = result.Error;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _scheduling = false;
        }
    }

    private async Task CancelScheduledUpdate()
    {
        if (_pendingSchedule is null) return;

        try
        {
            _cancellingSchedule = true;
            _error = null;

            var result = await ScheduleService.CancelScheduledUpdateAsync(
                _pendingSchedule.Id,
                GetCurrentUserId());

            if (result.IsSuccess)
            {
                _success = "Scheduled update cancelled.";
                _pendingSchedule = null;
            }
            else
            {
                _error = result.Error;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _cancellingSchedule = false;
        }
    }

    private async Task StartUpdate()
    {
        if (_availableRelease is null) return;

        try
        {
            _updating = true;
            _error = null;

            // First download the update
            var downloadResult = await UpdateService.DownloadUpdateAsync(_availableRelease.Version);
            if (!downloadResult.Success)
            {
                _error = downloadResult.Error;
                return;
            }

            // Then apply it
            var options = new UpdateOptions
            {
                CreateBackup = true,
                StopGameServers = true,
                RestartGameServers = true
            };

            var applyResult = await UpdateService.ApplyUpdateAsync(_availableRelease.Version, options);
            if (applyResult.IsFailure)
            {
                _error = applyResult.Error;
            }
            // If successful, the app will restart
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _updating = false;
        }
    }

    private static string RenderMarkdown(string? markdown)
    {
        if (string.IsNullOrEmpty(markdown))
            return "<p>No release notes available.</p>";

        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();

        return Markdown.ToHtml(markdown, pipeline);
    }


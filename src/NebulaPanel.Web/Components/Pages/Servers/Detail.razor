    private async Task SendCommand()
    {
        if (string.IsNullOrWhiteSpace(_commandInput) || _server?.Status != ServerStatus.Running)
            return;

        _sendingCommand = true;
        try
        {
            var command = _commandInput;
            _commandInput = "";

            _consoleLines.Add($"> {command}");

            var result = await ServerService.SendCommandAsync(ServerId, command);
            if (!result.IsSuccess)
            {
                _consoleLines.Add($"[Error] {result.Error}");
            }
            else if (!string.IsNullOrEmpty(result.Value))
            {
                // Display RCON response - split by newlines for multi-line responses
                foreach (var line in result.Value.Split('\n', StringSplitOptions.RemoveEmptyEntries))
                {
                    _consoleLines.Add(line.TrimEnd('\r'));
                }
            }

            StateHasChanged();

            if (_autoScroll)
            {
                await ScrollConsoleToBottomAsync();
            }
        }
        finally
        {
            _sendingCommand = false;
        }
    }


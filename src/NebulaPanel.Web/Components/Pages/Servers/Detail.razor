    private void StartConsoleStream()
    {
        _consoleCts?.Cancel();
        _consoleCts = new CancellationTokenSource();

        _ = Task.Run(async () =>
        {
            try
            {
                await foreach (var line in ServerService.StreamConsoleAsync(ServerId, _consoleCts.Token))
                {
                    await InvokeAsync(async () =>
                    {
                        _consoleLines.Add(line);
                        if (_consoleLines.Count > 1000)

            }
            catch (Exception ex)
            {
                Console.WriteLine($"Resource monitoring error: {ex.Message}");
            }
            finally
            {
                _resourceMonitoringInProgress = false;
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(2));
    }


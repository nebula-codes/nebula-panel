                            _consoleLines.RemoveAt(0);
                        }
                        StateHasChanged();

                        if (_autoScroll)
                        {
                            await ScrollConsoleToBottomAsync();
                        }
                    });
                }
            }
            catch (OperationCanceledException)
            {
                // Expected when stopping
            }
        });

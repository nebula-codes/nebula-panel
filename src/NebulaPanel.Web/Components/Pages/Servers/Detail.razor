    private static string FormatTaskTime(DateTime dateTime)
    {
        var diff = dateTime - DateTime.UtcNow;

        if (diff.TotalSeconds < 0)
        {
            diff = -diff;
            if (diff.TotalMinutes < 1) return "Just now";
            if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
            if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
            return dateTime.ToLocalTime().ToString("MMM d");
        }
        else
        {
            if (diff.TotalMinutes < 1) return "< 1m";
            if (diff.TotalMinutes < 60) return $"in {(int)diff.TotalMinutes}m";
            if (diff.TotalHours < 24) return $"in {(int)diff.TotalHours}h";
            return dateTime.ToLocalTime().ToString("MMM d");
        }
    }

    private async Task LoadServerAsync()
    {
        try
        {
            _loading = true;
            _error = null;
            var result = await ServerService.GetServerByIdAsync(ServerId);

            if (result.IsSuccess)
            {
                _server = result.Value;

                // Initialize startup script settings from server config
                if (_server.NativeConfig is not null)
                {
                    _useStartupScript = _server.NativeConfig.UseStartupScript;
                    _startupScriptPath = _server.NativeConfig.StartupScriptPath;
                }

                // Detect available scripts in server directory (for both Native and Docker)
                if (_server.GameName == "Minecraft: Java Edition" &&
                    !string.IsNullOrEmpty(_server.InstallPath) && Directory.Exists(_server.InstallPath))
                {
                    _detectedScripts = DetectStartupScripts(_server.InstallPath);

                    // For Docker servers without NativeConfig, auto-select first script if available
                    if (_server.DeploymentType == ServerDeploymentType.Docker &&
                        _server.NativeConfig is null &&
                        _detectedScripts.Count > 0 &&
                        string.IsNullOrEmpty(_startupScriptPath))
                    {
                        // Check if any script was previously configured (stored in DockerConfig or elsewhere)
                        // For now, we'll rely on the toggle to enable script mode
                    }
                }

                // Initialize RCON settings from server config or server.properties
                if (_server.RconConfig is not null && !string.IsNullOrEmpty(_server.RconConfig.Password))
                {
                    _rconEnabled = _server.RconConfig.Enabled;
                    _rconHost = _server.RconConfig.Host;
                    _rconPort = _server.RconConfig.Port;
                    _rconPassword = _server.RconConfig.Password;
                }
                else
                {
                    // Try to read from server.properties if it exists
                    var serverPropertiesPath = Path.Combine(_server.InstallPath, "server.properties");
                    if (File.Exists(serverPropertiesPath))
                    {
                        try
                        {
                            var props = await File.ReadAllLinesAsync(serverPropertiesPath);
                            foreach (var line in props)
                            {
                                var trimmed = line.Trim();
                                if (trimmed.StartsWith("rcon.password="))
                                {
                                    _rconPassword = trimmed["rcon.password=".Length..];
                                }
                                else if (trimmed.StartsWith("rcon.port=") && int.TryParse(trimmed["rcon.port=".Length..], out var port))
                                {
                                    _rconPort = port;
                                }
                                else if (trimmed.StartsWith("enable-rcon="))
                                {
                                    _rconEnabled = trimmed["enable-rcon=".Length..].Equals("true", StringComparison.OrdinalIgnoreCase);
                                }
                            }

                            // Use existing host from config or default
                            _rconHost = _server.RconConfig?.Host ?? "127.0.0.1";
                        }
                        catch
                        {
                            // Failed to read server.properties, use defaults
                            _rconEnabled = false;
                            _rconHost = "127.0.0.1";
                            _rconPort = 25575;
                            _rconPassword = "";
                        }
                    }
                    else
                    {
                        // Set defaults
                        _rconEnabled = false;
                        _rconHost = "127.0.0.1";
                        _rconPort = 25575;
                        _rconPassword = "";
                    }
                }
            }
            else
            {
                _error = result.Error;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }


@page "/servers/{ServerId:guid}"
@attribute [Authorize]
@using NebulaPanel.Application.Common
@using NebulaPanel.Application.DTOs
@using NebulaPanel.Application.Services
@using NebulaPanel.Domain.Enums
@using NebulaPanel.Domain.Interfaces
@using NebulaPanel.Domain.ValueObjects
@using NebulaPanel.Web.Components.Shared.FileExplorer
@using NebulaPanel.Web.Components.Shared.Minecraft
@using NebulaPanel.Web.Components.Shared.Hytale
@using NebulaPanel.Web.Components.Shared.Terraria
@using NebulaPanel.Domain.Repositories
@using NebulaPanel.Web.Services
@inject IGameServerService ServerService
@inject IUnifiedModService ModService
@inject IScheduledTaskService TaskService
@inject IBackupService BackupService
@inject IModpackUpdateService ModpackUpdateService
@inject IDashboardService DashboardService
@inject IGameServerRepository ServerRepository
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IToastService ToastService
@implements IDisposable

<PageTitle>@(_server?.Name ?? "Server") - Nebula Panel</PageTitle>

<div class="py-6 px-4">
    @if (_loading)
    {
        <SkeletonCard Variant="SkeletonCard.SkeletonVariant.DetailHeader" />
        <SkeletonCard Variant="SkeletonCard.SkeletonVariant.TabContent" />
    }
    else if (_error != null)
    {
        <ErrorAlert Message="@_error" />
        <Button Variant="ButtonVariant.Secondary"
                Text="Back to Servers"
                Class="mt-4"
                OnClick="@(() => Navigation.NavigateTo("/servers"))" />
    }
    else if (_server != null)
    {
        @* Header *@
        <div class="flex items-start justify-between gap-4 mb-6">
            <div class="flex items-center gap-4">
                <Button Variant="ButtonVariant.Ghost"
                        IconName="arrow-left"
                        IconOnly="true"
                        OnClick="@(() => Navigation.NavigateTo("/servers"))" />

                @if (!string.IsNullOrEmpty(_server.EffectiveIcon))
                {
                    <img src="@_server.EffectiveIcon" alt="@_server.GameName" class="w-12 h-12 object-contain rounded-lg" />
                }
                else
                {
                    <div class="w-12 h-12 bg-nebula-bg-tertiary rounded-lg flex items-center justify-center">
                        <Icon Name="server" Size="IconSize.Large" Class="text-nebula-text-muted" />
                    </div>
                }

                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-2xl font-semibold text-nebula-text-primary">@_server.Name</h1>
                        <StatusBadge Status="@GetStatusType(_server.Status)"
                                     Text="@_server.Status.ToString()"
                                     ShowDot="true"
                                     Size="BadgeSize.Large" />
                    </div>
                    <div class="flex items-center gap-4 mt-1 text-sm text-nebula-text-muted">
                        <span>@_server.GameName</span>
                        <span class="flex items-center gap-1">
                            <Icon Name="@(_server.DeploymentType == ServerDeploymentType.Docker ? "box" : "terminal")" Size="IconSize.Small" />
                            @_server.DeploymentType
                        </span>
                        <code class="bg-nebula-bg-tertiary px-2 py-0.5 rounded">@_server.BindAddress:@_server.PrimaryPort</code>
                    </div>
                </div>
            </div>

            @* Control Buttons *@
            <div class="flex items-center gap-2">
                @if (_server.Status == ServerStatus.Running)
                {
                    <Button Variant="ButtonVariant.Secondary"
                            Text="Stop"
                            IconName="square"
                            Loading="_stopping"
                            Disabled="_actionInProgress"
                            OnClick="StopServer" />
                    <Button Variant="ButtonVariant.Secondary"
                            Text="Restart"
                            IconName="refresh-cw"
                            Loading="_restarting"
                            Disabled="_actionInProgress"
                            OnClick="RestartServer" />
                }
                else if (_server.Status == ServerStatus.Stopped || _server.Status == ServerStatus.Unknown || _server.Status == ServerStatus.Crashed)
                {
                    <Button Variant="ButtonVariant.Primary"
                            Text="Start"
                            IconName="play"
                            Loading="_starting"
                            Disabled="_actionInProgress"
                            OnClick="StartServer" />
                    @if (_server.DeploymentType == ServerDeploymentType.Docker)
                    {
                        <Button Variant="ButtonVariant.Secondary"
                                Text="Recreate Container"
                                IconName="refresh-cw"
                                Loading="_recreatingContainer"
                                Disabled="_actionInProgress"
                                OnClick="RecreateContainer" />
                    }
                }
                else if (_server.Status == ServerStatus.Starting || _server.Status == ServerStatus.Stopping)
                {
                    <Button Variant="ButtonVariant.Danger"
                            Text="Kill"
                            IconName="x"
                            Loading="_killing"
                            Disabled="_actionInProgress"
                            OnClick="KillServer" />
                }
                else if (_server.Status == ServerStatus.Installing || _server.Status == ServerStatus.Updating)
                {
                    <div class="flex items-center gap-2 text-nebula-text-muted px-3">
                        <span class="spinner"></span>
                        <span>@(_server.Status == ServerStatus.Installing ? "Installing..." : "Updating...")</span>
                    </div>
                }
            </div>
        </div>

        @if (_actionError != null)
        {
            <div class="mb-4 p-3 bg-nebula-error/10 border border-nebula-error/30 rounded-lg text-sm text-nebula-error flex items-center gap-2">
                <Icon Name="alert-circle" Size="IconSize.Small" />
                @_actionError
                <button class="ml-auto hover:text-nebula-error/80" @onclick="@(() => _actionError = null)">
                    <Icon Name="x" Size="IconSize.Small" />
                </button>
            </div>
        }

        @* Modpack Update Banner *@
        @if (_modpackUpdateInfo is not null && !_showUpdateProgressModal)
        {
            <ModpackUpdateBanner UpdateInfo="_modpackUpdateInfo"
                                 OnViewDetails="@(() => _showUpdateModal = true)"
                                 OnDismiss="DismissModpackUpdate" />
        }

        @* Tab Navigation *@
        <TabNav TValue="string"
                Tabs="@_tabs"
                @bind-Value="_activeTab"
                @bind-Value:after="OnTabChanged"
                LabelSelector="@(t => t)"
                IconSelector="@GetTabIcon" />

        @* Tab Content *@
        <div class="mt-6">
            @switch (_activeTab)
            {
                case "Overview":
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        @* Server Info *@
                        <Card>
                            <Header>
                                <h2 class="text-base font-medium text-nebula-text-primary">Server Details</h2>
                            </Header>
                            <ChildContent>
                                <div class="space-y-3 text-sm">
                                    <div class="flex items-center justify-between">
                                        <span class="text-nebula-text-muted">Install Path</span>
                                        <code class="text-nebula-text-secondary bg-nebula-bg-tertiary px-2 py-0.5 rounded text-xs truncate max-w-[200px]" title="@_server.InstallPath">
                                            @TruncatePath(_server.InstallPath)
                                        </code>
                                    </div>
                                    @if (_server.ProcessId.HasValue)
                                    {
                                        <div class="flex items-center justify-between">
                                            <span class="text-nebula-text-muted">Process ID</span>
                                            <span class="text-nebula-text-secondary font-mono">@_server.ProcessId</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(_server.DockerContainerId))
                                    {
                                        <div class="flex items-center justify-between">
                                            <span class="text-nebula-text-muted">Container</span>
                                            <code class="text-nebula-text-secondary bg-nebula-bg-tertiary px-2 py-0.5 rounded text-xs">
                                                @_server.DockerContainerId[..Math.Min(12, _server.DockerContainerId.Length)]
                                            </code>
                                        </div>
                                    }
                                    @if (_server.LastStarted.HasValue)
                                    {
                                        <div class="flex items-center justify-between">
                                            <span class="text-nebula-text-muted">Last Started</span>
                                            <span class="text-nebula-text-secondary" title="@_server.LastStarted.Value.ToString("f")">
                                                @FormatRelativeTime(_server.LastStarted.Value)
                                            </span>
                                        </div>
                                    }
                                    <div class="flex items-center justify-between">
                                        <span class="text-nebula-text-muted">Owner</span>
                                        <span class="text-nebula-text-secondary">@_server.OwnerUsername</span>
                                    </div>
                                </div>
                            </ChildContent>
                        </Card>

                        @* Resource Usage - Enhanced with Chart *@
                        <Card Class="lg:col-span-2">
                            <Header>
                                <div class="flex items-center justify-between w-full">
                                    <h2 class="text-base font-medium text-nebula-text-primary">Resources</h2>
                                    <div class="flex gap-1">
                                        <button @onclick="@(() => OnResourceTimeRangeChanged(TimeSpan.FromHours(1)))"
                                                class="@GetResourceTimeRangeButtonClass(TimeSpan.FromHours(1))">
                                            1h
                                        </button>
                                        <button @onclick="@(() => OnResourceTimeRangeChanged(TimeSpan.FromHours(6)))"
                                                class="@GetResourceTimeRangeButtonClass(TimeSpan.FromHours(6))">
                                            6h
                                        </button>
                                        <button @onclick="@(() => OnResourceTimeRangeChanged(TimeSpan.FromHours(24)))"
                                                class="@GetResourceTimeRangeButtonClass(TimeSpan.FromHours(24))">
                                            24h
                                        </button>
                                        <button @onclick="@(() => OnResourceTimeRangeChanged(TimeSpan.FromDays(7)))"
                                                class="@GetResourceTimeRangeButtonClass(TimeSpan.FromDays(7))">
                                            7d
                                        </button>
                                    </div>
                                </div>
                            </Header>
                            <ChildContent>
                                @if (_server.Status == ServerStatus.Running && _resourceUsage != null)
                                {
                                    <div class="grid grid-cols-3 gap-4 mb-4">
                                        <div class="text-center p-3 bg-nebula-bg-tertiary rounded-lg">
                                            <div class="text-2xl font-bold text-nebula-accent">@_resourceUsage.CpuPercent.ToString("F1")%</div>
                                            <span class="text-xs text-nebula-text-muted">CPU</span>
                                        </div>
                                        <div class="text-center p-3 bg-nebula-bg-tertiary rounded-lg">
                                            <div class="text-2xl font-bold text-nebula-success">@FormatBytes(_resourceUsage.MemoryBytes)</div>
                                            <span class="text-xs text-nebula-text-muted">Memory</span>
                                        </div>
                                        <div class="text-center p-3 bg-nebula-bg-tertiary rounded-lg">
                                            <div class="text-2xl font-bold text-nebula-text-primary">@FormatUptime(_resourceUsage.Uptime)</div>
                                            <span class="text-xs text-nebula-text-muted">Uptime</span>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="grid grid-cols-3 gap-4 mb-4">
                                        <div class="text-center p-3 bg-nebula-bg-tertiary rounded-lg">
                                            <div class="text-2xl font-bold text-nebula-text-muted">--%</div>
                                            <span class="text-xs text-nebula-text-muted">CPU</span>
                                        </div>
                                        <div class="text-center p-3 bg-nebula-bg-tertiary rounded-lg">
                                            <div class="text-2xl font-bold text-nebula-text-muted">--</div>
                                            <span class="text-xs text-nebula-text-muted">Memory</span>
                                        </div>
                                        <div class="text-center p-3 bg-nebula-bg-tertiary rounded-lg">
                                            <div class="text-2xl font-bold text-nebula-text-muted">--</div>
                                            <span class="text-xs text-nebula-text-muted">Uptime</span>
                                        </div>
                                    </div>
                                }

                                @* Resource History Chart *@
                                @if (_loadingResourceHistory)
                                {
                                    <div class="flex items-center justify-center h-[200px]">
                                        <span class="spinner"></span>
                                    </div>
                                }
                                else if (_serverResourceHistory.Count == 0)
                                {
                                    <div class="flex items-center justify-center h-[200px] text-nebula-text-muted">
                                        <div class="text-center">
                                            <Icon Name="bar-chart-2" Size="IconSize.Large" Class="mb-2 opacity-40" />
                                            <p class="text-sm">No historical data available</p>
                                            <p class="text-xs mt-1">Data is collected every minute while the server is running</p>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <ResourceHistoryChart DataPoints="_serverResourceHistory" />
                                }
                            </ChildContent>
                        </Card>

                        @* Network *@
                        <Card>
                            <Header>
                                <h2 class="text-base font-medium text-nebula-text-primary">Network</h2>
                            </Header>
                            <ChildContent>
                                <div class="space-y-3 text-sm">
                                    <div class="flex items-center justify-between">
                                        <span class="text-nebula-text-muted">Primary Port</span>
                                        <code class="text-nebula-text-secondary bg-nebula-bg-tertiary px-2 py-0.5 rounded text-xs">
                                            @_server.BindAddress:@_server.PrimaryPort
                                        </code>
                                    </div>
                                    @foreach (var port in _server.AdditionalPorts)
                                    {
                                        <div class="flex items-center justify-between">
                                            <span class="text-nebula-text-muted capitalize">@port.Key</span>
                                            <code class="text-nebula-text-secondary bg-nebula-bg-tertiary px-2 py-0.5 rounded text-xs">
                                                @_server.BindAddress:@port.Value
                                            </code>
                                        </div>
                                    }
                                </div>
                            </ChildContent>
                        </Card>

                        @* Installed Modpack (only if modpack installed) *@
                        @if (_server.InstalledModpack is not null)
                        {
                            <Card>
                                <Header>
                                    <div class="flex items-center justify-between">
                                        <h2 class="text-base font-medium text-nebula-text-primary">Installed Modpack</h2>
                                        <Button Variant="ButtonVariant.Ghost"
                                                Size="ButtonSize.Small"
                                                IconName="refresh-cw"
                                                Text="Check Updates"
                                                Loading="_checkingModpackUpdates"
                                                OnClick="CheckForModpackUpdates" />
                                    </div>
                                </Header>
                                <ChildContent>
                                    <div class="space-y-3 text-sm">
                                        <div class="flex items-center justify-between">
                                            <span class="text-nebula-text-muted">Modpack</span>
                                            <span class="text-nebula-text-primary font-medium">@_server.InstalledModpack.ModpackName</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-nebula-text-muted">Version</span>
                                            <div class="flex items-center gap-2">
                                                <span class="text-nebula-text-secondary">@(_server.InstalledModpack.VersionName ?? _server.InstalledModpack.VersionId)</span>
                                                @if (_server.InstalledModpack.UpdateAvailable)
                                                {
                                                    <StatusBadge Status="StatusType.Info" Text="Update" ShowDot="true" Size="BadgeSize.Small" />
                                                }
                                            </div>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-nebula-text-muted">Minecraft</span>
                                            <span class="text-nebula-text-secondary">@_server.InstalledModpack.MinecraftVersion</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-nebula-text-muted">Mod Loader</span>
                                            <StatusBadge Status="StatusType.Info"
                                                         Text="@($"{_server.InstalledModpack.LoaderType} {_server.InstalledModpack.LoaderVersion}")"
                                                         Size="BadgeSize.Small" />
                                        </div>
                                        @if (_server.InstalledModpack.ModCount.HasValue)
                                        {
                                            <div class="flex items-center justify-between">
                                                <span class="text-nebula-text-muted">Mods</span>
                                                <span class="text-nebula-text-secondary">@_server.InstalledModpack.ModCount mods</span>
                                            </div>
                                        }
                                        <div class="flex items-center justify-between">
                                            <span class="text-nebula-text-muted">Installed</span>
                                            <span class="text-nebula-text-secondary">@FormatRelativeTime(_server.InstalledModpack.InstalledAt)</span>
                                        </div>
                                        @if (_server.InstalledModpack.LastUpdateCheckAt.HasValue)
                                        {
                                            <div class="flex items-center justify-between text-xs text-nebula-text-muted">
                                                <span>Last checked</span>
                                                <span>@FormatRelativeTime(_server.InstalledModpack.LastUpdateCheckAt.Value)</span>
                                            </div>
                                        }
                                    </div>
                                </ChildContent>
                            </Card>
                        }
                    </div>
                    break;

                case "Console":
                    <Card NoPadding="true" Class="overflow-hidden">
                        <ChildContent>
                            @* Console toolbar *@
                            <div class="flex items-center justify-between px-4 py-2 bg-nebula-bg-tertiary border-b border-nebula-border">
                                <span class="text-sm font-medium text-nebula-text-secondary">Server Console</span>
                                <div class="flex items-center gap-3">
                                    @* Search toggle *@
                                    <Button Variant="ButtonVariant.Ghost"
                                            Size="ButtonSize.Small"
                                            IconName="search"
                                            IconOnly="true"
                                            OnClick="@(() => { _showConsoleSearch = !_showConsoleSearch; if (!_showConsoleSearch) _consoleSearchQuery = ""; })"
                                            title="Search console"
                                            Class="@(_showConsoleSearch ? "text-nebula-accent" : "")" />
                                    <label class="flex items-center gap-2 text-sm text-nebula-text-secondary cursor-pointer select-none">
                                        <input type="checkbox" @bind="_autoScroll" class="w-4 h-4 rounded border-nebula-border bg-nebula-bg-secondary text-nebula-accent focus:ring-nebula-accent focus:ring-offset-0" />
                                        Auto-scroll
                                    </label>
                                    <Button Variant="ButtonVariant.Ghost"
                                            Size="ButtonSize.Small"
                                            IconName="download"
                                            IconOnly="true"
                                            OnClick="DownloadConsoleLog"
                                            Disabled="@(_consoleLines.Count == 0)"
                                            title="Download log" />
                                    <Button Variant="ButtonVariant.Ghost"
                                            Size="ButtonSize.Small"
                                            IconName="copy"
                                            IconOnly="true"
                                            OnClick="CopyConsoleLog"
                                            Disabled="@(_consoleLines.Count == 0)"
                                            title="Copy to clipboard" />
                                    <Button Variant="ButtonVariant.Ghost"
                                            Size="ButtonSize.Small"
                                            IconName="trash-2"
                                            IconOnly="true"
                                            OnClick="ClearConsole"
                                            title="Clear" />
                                </div>
                            </div>

                            @* Search bar *@
                            @if (_showConsoleSearch)
                            {
                                <div class="flex items-center gap-2 px-4 py-2 bg-nebula-bg-secondary border-b border-nebula-border">
                                    <Icon Name="search" Size="IconSize.Small" Class="text-nebula-text-muted" />
                                    <input type="text"
                                           @bind="_consoleSearchQuery"
                                           @bind:event="oninput"
                                           placeholder="Search console output..."
                                           class="flex-1 bg-transparent text-nebula-text-primary text-sm outline-none placeholder:text-nebula-text-muted" />
                                    @if (!string.IsNullOrEmpty(_consoleSearchQuery))
                                    {
                                        <span class="text-xs text-nebula-text-muted">@ConsoleSearchMatchCount match(es)</span>
                                        <Button Variant="ButtonVariant.Ghost"
                                                Size="ButtonSize.Small"
                                                IconName="x"
                                                IconOnly="true"
                                                OnClick="@(() => _consoleSearchQuery = "")" />
                                    }
                                </div>
                            }

                            @* Console output *@
                            <div class="h-[500px] overflow-y-auto p-4 font-mono text-xs leading-relaxed bg-[#0d1117] relative" @ref="_consoleOutput">
                                @if (_consoleLines.Count == 0)
                                {
                                    <div class="text-gray-500 text-center py-8">
                                        @if (_server.Status == ServerStatus.Running)
                                        {
                                            <span>Waiting for output...</span>
                                        }
                                        else
                                        {
                                            <span>Server is not running. Start the server to see console output.</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @foreach (var line in FilteredConsoleLines)
                                    {
                                        <div class="@GetConsoleLineClass(line) whitespace-pre-wrap break-all hover:bg-white/5 px-1 -mx-1">@line</div>
                                    }
                                }
                            </div>

                            @* Command input *@
                            <div class="flex items-center gap-2 px-4 py-3 bg-nebula-bg-tertiary border-t border-nebula-border">
                                <span class="text-nebula-accent font-mono">&gt;</span>
                                <input type="text"
                                       @bind="_commandInput"
                                       @bind:event="oninput"
                                       @onkeydown="HandleCommandKeyDown"
                                       placeholder="@(_server.Status == ServerStatus.Running ? "Type a command..." : "Server is not running")"
                                       disabled="@(_server.Status != ServerStatus.Running)"
                                       class="flex-1 bg-transparent text-nebula-text-primary text-sm outline-none placeholder:text-nebula-text-muted font-mono" />
                                <Button Variant="ButtonVariant.Primary"
                                        Size="ButtonSize.Small"
                                        Text="Send"
                                        Loading="_sendingCommand"
                                        Disabled="@(_server.Status != ServerStatus.Running || string.IsNullOrWhiteSpace(_commandInput))"
                                        OnClick="SendCommand" />
                            </div>
                        </ChildContent>
                    </Card>
                    break;

                case "Files":
                    <FileExplorer ServerId="@ServerId" InitialPath="@_fileExplorerPath" />
                    break;

                case "Worlds":
                    @if (_server?.HytaleInfo != null)
                    {
                        <HytaleWorldsTab ServerId="@ServerId" OnNavigateToFiles="NavigateToFilesTab" />
                    }
                    break;

                case "Updates":
                    @if (_server?.HytaleInfo != null)
                    {
                        <HytaleUpdateTab Server="@_server" UserId="@_server.OwnerId" OnUpdateStateChanged="OnHytaleUpdateStateChanged" />
                    }
                    break;

                case "Mods":
                    @* Check for Terraria servers - show specialized mods tab *@
                    @if (IsTerrariaServer())
                    {
                        <TerrariaModsTab ServerId="@ServerId" />
                    }
                    else
                    {
                    <div class="space-y-4">
                        @* Sub-tabs for Mods *@
                        <div class="flex items-center gap-1 border-b border-nebula-border-subtle">
                            <button type="button"
                                    class="px-4 py-2 text-sm font-medium transition-colors @(_modsSubTab == "installed" ? "text-nebula-accent border-b-2 border-nebula-accent" : "text-nebula-text-muted hover:text-nebula-text-primary")"
                                    @onclick="@(() => _modsSubTab = "installed")">
                                Installed
                                @if (_installedMods.Count > 0)
                                {
                                    <span class="ml-1.5 px-1.5 py-0.5 text-xs rounded-full bg-nebula-bg-tertiary">@_installedMods.Count</span>
                                }
                            </button>
                            <button type="button"
                                    class="px-4 py-2 text-sm font-medium transition-colors @(_modsSubTab == "browse" ? "text-nebula-accent border-b-2 border-nebula-accent" : "text-nebula-text-muted hover:text-nebula-text-primary")"
                                    @onclick="@(() => _modsSubTab = "browse")">
                                Browse
                            </button>
                            @if (_availableUpdates.Count > 0)
                            {
                                <button type="button"
                                        class="px-4 py-2 text-sm font-medium transition-colors @(_modsSubTab == "updates" ? "text-nebula-accent border-b-2 border-nebula-accent" : "text-nebula-text-muted hover:text-nebula-text-primary")"
                                        @onclick="@(() => _modsSubTab = "updates")">
                                    Updates
                                    <span class="ml-1.5 px-1.5 py-0.5 text-xs rounded-full bg-nebula-warning/20 text-nebula-warning">@_availableUpdates.Count</span>
                                </button>
                            }
                        </div>

                        @* Sub-tab Content *@
                        @switch (_modsSubTab)
                        {
                            case "installed":
                                @* Installed mods list *@
                                @if (_loadingMods)
                                {
                                    <div class="flex items-center justify-center py-8">
                                        <span class="spinner w-6 h-6"></span>
                                        <span class="ml-2 text-nebula-text-muted">Loading mods...</span>
                                    </div>
                                }
                                else if (_installedMods.Count == 0)
                                {
                                    <div class="text-center py-12">
                                        <Icon Name="package" Size="IconSize.Large" Class="text-nebula-text-muted mx-auto mb-4 opacity-50" />
                                        <h3 class="text-base font-medium text-nebula-text-primary mb-2">No mods installed</h3>
                                        <p class="text-sm text-nebula-text-muted mb-4">
                                            Browse and install mods to enhance your server.
                                        </p>
                                        <Button Variant="ButtonVariant.Primary"
                                                Text="Browse Mods"
                                                IconName="search"
                                                OnClick="@(() => _modsSubTab = "browse")" />
                                    </div>
                                }
                                else
                                {
                                    <div class="grid gap-3">
                                        @foreach (var mod in _installedMods)
                                        {
                                            var hasUpdate = _availableUpdates.Any(u => u.InstalledModId == mod.Id);
                                            <div class="bg-nebula-bg-secondary rounded-nebula border border-nebula-border p-4 hover:border-nebula-border-subtle transition-colors">
                                                <div class="flex items-center gap-4">
                                                    @if (!string.IsNullOrEmpty(mod.IconUrl))
                                                    {
                                                        <img src="@mod.IconUrl" alt="@mod.Name" class="w-10 h-10 object-cover rounded-lg flex-shrink-0" />
                                                    }
                                                    else
                                                    {
                                                        <div class="w-10 h-10 bg-nebula-bg-tertiary rounded-lg flex items-center justify-center flex-shrink-0">
                                                            <Icon Name="package" Size="IconSize.Small" Class="text-nebula-text-muted" />
                                                        </div>
                                                    }
                                                    <div class="flex-1 min-w-0">
                                                        <div class="flex items-center gap-2">
                                                            <span class="font-medium text-nebula-text-primary truncate">@mod.Name</span>
                                                            @if (hasUpdate)
                                                            {
                                                                <StatusBadge Status="StatusType.Warning" Text="Update" ShowDot="true" Size="BadgeSize.Small" />
                                                            }
                                                        </div>
                                                        <div class="flex items-center gap-3 mt-1 text-xs text-nebula-text-muted">
                                                            <span class="bg-nebula-bg-tertiary px-2 py-0.5 rounded">@mod.Version</span>
                                                            <span class="bg-nebula-bg-tertiary px-2 py-0.5 rounded">@mod.Provider</span>
                                                            <span>Installed @FormatRelativeTime(mod.InstalledAt)</span>
                                                        </div>
                                                    </div>
                                                    <div class="flex items-center gap-1">
                                                        @* Enable/Disable toggle *@
                                                        <Button Variant="ButtonVariant.Ghost"
                                                                Size="ButtonSize.Small"
                                                                IconName="@(mod.IsEnabled ? "toggle-right" : "toggle-left")"
                                                                IconOnly="true"
                                                                Class="@(mod.IsEnabled ? "text-nebula-success" : "text-nebula-text-muted")"
                                                                title="@(mod.IsEnabled ? "Enabled - Click to disable" : "Disabled - Click to enable")"
                                                                OnClick="@(() => ToggleModEnabled(mod))" />
                                                        @* View details *@
                                                        <Button Variant="ButtonVariant.Ghost"
                                                                Size="ButtonSize.Small"
                                                                IconName="eye"
                                                                IconOnly="true"
                                                                title="View details"
                                                                OnClick="@(() => ViewModDetails(mod))" />
                                                        @* Delete *@
                                                        <Button Variant="ButtonVariant.Ghost"
                                                                Size="ButtonSize.Small"
                                                                IconName="trash-2"
                                                                IconOnly="true"
                                                                Class="hover:text-nebula-error"
                                                                title="Delete mod"
                                                                OnClick="@(() => ConfirmDeleteMod(mod))" />
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                break;

                            case "browse":
                                @* Mod Browser - reuse HytaleModBrowser for Hytale, or generic for others *@
                                @if (_server?.HytaleInfo != null)
                                {
                                    <HytaleModBrowser ServerId="_server.Id" OnModInstalled="RefreshServerAsync" />
                                }
                                else
                                {
                                    <div class="text-center py-12">
                                        <Icon Name="search" Size="IconSize.Large" Class="text-nebula-text-muted mx-auto mb-4 opacity-50" />
                                        <h3 class="text-base font-medium text-nebula-text-primary mb-2">Mod Browser</h3>
                                        <p class="text-sm text-nebula-text-muted">
                                            Search and install mods from CurseForge, Modrinth, and other providers.
                                        </p>
                                        <Button Variant="ButtonVariant.Primary"
                                                Text="Open Full Browser"
                                                IconName="external-link"
                                                Class="mt-4"
                                                OnClick="@(() => Navigation.NavigateTo($"/servers/{ServerId}/mods"))" />
                                    </div>
                                }
                                break;

                            case "updates":
                                @* Available Updates *@
                                @if (_availableUpdates.Count == 0)
                                {
                                    <div class="text-center py-12">
                                        <Icon Name="check-circle" Size="IconSize.Large" Class="text-nebula-success mx-auto mb-4" />
                                        <h3 class="text-base font-medium text-nebula-text-primary mb-2">All mods up to date</h3>
                                        <p class="text-sm text-nebula-text-muted">
                                            No updates available for your installed mods.
                                        </p>
                                    </div>
                                }
                                else
                                {
                                    <div class="space-y-4">
                                        <div class="flex items-center justify-between">
                                            <p class="text-sm text-nebula-text-muted">
                                                @_availableUpdates.Count update(s) available
                                            </p>
                                            <Button Variant="ButtonVariant.Primary"
                                                    Text="Update All"
                                                    IconName="refresh-cw"
                                                    Size="ButtonSize.Small" />
                                        </div>
                                        <div class="grid gap-3">
                                            @foreach (var update in _availableUpdates)
                                            {
                                                var mod = _installedMods.FirstOrDefault(m => m.Id == update.InstalledModId);
                                                <div class="bg-nebula-bg-secondary rounded-nebula border border-nebula-border p-4">
                                                    <div class="flex items-center gap-4">
                                                        <div class="w-10 h-10 bg-nebula-bg-tertiary rounded-lg flex items-center justify-center flex-shrink-0">
                                                            <Icon Name="package" Size="IconSize.Small" Class="text-nebula-text-muted" />
                                                        </div>
                                                        <div class="flex-1 min-w-0">
                                                            <span class="font-medium text-nebula-text-primary">@update.ModName</span>
                                                            <div class="flex items-center gap-2 mt-1 text-xs text-nebula-text-muted">
                                                                <span>@(mod?.Version ?? "Unknown")</span>
                                                                <Icon Name="arrow-right" Size="IconSize.XSmall" />
                                                                <span class="text-nebula-success">@update.LatestVersion</span>
                                                            </div>
                                                        </div>
                                                        <Button Variant="ButtonVariant.Secondary"
                                                                Text="Update"
                                                                IconName="download"
                                                                Size="ButtonSize.Small" />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                break;
                        }
                    </div>
                    }
                    break;

                case "Config":
                    <ServerConfigPanel ServerId="@ServerId" />
                    break;

                case "Schedule":
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <h2 class="text-lg font-medium text-nebula-text-primary">Scheduled Tasks</h2>
                                <p class="text-sm text-nebula-text-muted mt-1">
                                    Automate server operations like restarts, backups, and commands.
                                </p>
                            </div>
                            <Button Variant="ButtonVariant.Primary"
                                    Text="Manage Tasks"
                                    IconName="settings"
                                    Size="ButtonSize.Small"
                                    OnClick="@(() => Navigation.NavigateTo($"/servers/{ServerId}/schedule"))" />
                        </div>

                        @if (_loadingTasks)
                        {
                            <div class="flex items-center justify-center py-8">
                                <span class="spinner w-6 h-6"></span>
                                <span class="ml-2 text-nebula-text-muted">Loading tasks...</span>
                            </div>
                        }
                        else if (_scheduledTasks.Count == 0)
                        {
                            <Card>
                                <ChildContent>
                                    <div class="text-center py-6">
                                        <Icon Name="clock" Size="IconSize.Large" Class="text-nebula-text-muted mx-auto mb-3" />
                                        <p class="text-nebula-text-muted">No scheduled tasks configured yet.</p>
                                        <Button Variant="ButtonVariant.Primary"
                                                Text="Create Task"
                                                IconName="plus"
                                                Size="ButtonSize.Small"
                                                Class="mt-4"
                                                OnClick="@(() => Navigation.NavigateTo($"/servers/{ServerId}/schedule"))" />
                                    </div>
                                </ChildContent>
                            </Card>
                        }
                        else
                        {
                            <div class="grid gap-3">
                                @foreach (var task in _scheduledTasks)
                                {
                                    <div class="bg-nebula-bg-secondary rounded-nebula border border-nebula-border p-4 hover:border-nebula-border-subtle transition-colors">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-lg flex items-center justify-center @GetTaskTypeColor(task.TaskType)">
                                                    <Icon Name="@GetTaskTypeIcon(task.TaskType)" Size="IconSize.Small" />
                                                </div>
                                                <div>
                                                    <div class="font-medium text-nebula-text-primary">@task.Name</div>
                                                    <div class="text-sm text-nebula-text-muted flex items-center gap-2">
                                                        <span>@task.TaskType</span>
                                                        @if (!string.IsNullOrEmpty(task.CronExpression))
                                                        {
                                                            <span class="text-nebula-text-muted">•</span>
                                                            <code class="text-xs bg-nebula-bg-tertiary px-1.5 py-0.5 rounded">@task.CronExpression</code>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-4">
                                                <div class="text-right text-sm">
                                                    @if (task.NextRunAt.HasValue)
                                                    {
                                                        <div class="text-nebula-text-secondary">Next: @FormatTaskTime(task.NextRunAt.Value)</div>
                                                    }
                                                    @if (task.LastRunAt.HasValue)
                                                    {
                                                        <div class="text-nebula-text-muted text-xs">Last: @FormatTaskTime(task.LastRunAt.Value)</div>
                                                    }
                                                </div>
                                                <StatusBadge Status="@(task.IsEnabled ? StatusBadge.StatusType.Success : StatusBadge.StatusType.Neutral)"
                                                             Text="@(task.IsEnabled ? "Enabled" : "Disabled")"
                                                             ShowDot="true"
                                                             Size="StatusBadge.BadgeSize.Small" />
                                                <div class="flex items-center gap-1">
                                                    <Button Variant="ButtonVariant.Ghost"
                                                            Size="ButtonSize.Small"
                                                            IconName="play"
                                                            IconOnly="true"
                                                            OnClick="@(() => RunTaskNow(task))"
                                                            title="Run Now" />
                                                    <Button Variant="ButtonVariant.Ghost"
                                                            Size="ButtonSize.Small"
                                                            IconName="@(task.IsEnabled ? "pause" : "play-circle")"
                                                            IconOnly="true"
                                                            OnClick="@(() => ToggleTaskEnabled(task))"
                                                            title="@(task.IsEnabled ? "Disable" : "Enable")" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    break;

                case "Backups":
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <div>
                                <h2 class="text-lg font-medium text-nebula-text-primary">Server Backups</h2>
                                <p class="text-sm text-nebula-text-muted mt-1">
                                    Create and manage backups for this server.
                                </p>
                            </div>
                            <div class="flex items-center gap-3">
                                @if (_backupSummary != null)
                                {
                                    <div class="text-right text-sm">
                                        <div class="text-nebula-text-secondary">@_backupSummary.TotalCount backups (@FormatBytes(_backupSummary.TotalSizeBytes))</div>
                                        @if (_backupSummary.LastBackupAt.HasValue)
                                        {
                                            <div class="text-nebula-text-muted text-xs">Last: @FormatRelativeTime(_backupSummary.LastBackupAt.Value)</div>
                                        }
                                    </div>
                                }
                                <Button Variant="ButtonVariant.Primary"
                                        Text="Create Backup"
                                        IconName="plus"
                                        Size="ButtonSize.Small"
                                        OnClick="@(() => _showCreateBackupModal = true)" />
                            </div>
                        </div>

                        @if (_loadingBackups)
                        {
                            <div class="flex items-center justify-center py-8">
                                <span class="spinner w-6 h-6"></span>
                                <span class="ml-2 text-nebula-text-muted">Loading backups...</span>
                            </div>
                        }
                        else if (_backups.Count == 0)
                        {
                            <Card>
                                <ChildContent>
                                    <div class="text-center py-6">
                                        <Icon Name="archive" Size="IconSize.Large" Class="text-nebula-text-muted mx-auto mb-3" />
                                        <p class="text-nebula-text-muted">No backups created yet.</p>
                                        <Button Variant="ButtonVariant.Primary"
                                                Text="Create Backup"
                                                IconName="plus"
                                                Size="ButtonSize.Small"
                                                Class="mt-4"
                                                OnClick="@(() => _showCreateBackupModal = true)" />
                                    </div>
                                </ChildContent>
                            </Card>
                        }
                        else
                        {
                            @if (_server.Status != ServerStatus.Stopped && _server.Status != ServerStatus.Unknown)
                            {
                                <div class="mb-4 p-3 bg-nebula-warning/10 border border-nebula-warning/30 rounded-lg text-sm text-nebula-warning flex items-center gap-2">
                                    <Icon Name="alert-triangle" Size="IconSize.Small" />
                                    Stop the server before restoring a backup.
                                </div>
                            }

                            <div class="grid gap-3">
                                @foreach (var backup in _backups)
                                {
                                    var isRestoring = _restoringBackupId == backup.Id;
                                    <div class="bg-nebula-bg-secondary rounded-nebula border border-nebula-border p-4 hover:border-nebula-border-subtle transition-colors @(isRestoring ? "opacity-75" : "")">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-3">
                                                @if (isRestoring)
                                                {
                                                    <div class="w-10 h-10 rounded-lg flex items-center justify-center bg-nebula-warning/20">
                                                        <span class="spinner w-5 h-5"></span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="w-10 h-10 rounded-lg flex items-center justify-center @(backup.Scope == BackupScope.Full ? "bg-nebula-accent/20 text-nebula-accent" : "bg-nebula-info/20 text-nebula-info")">
                                                        <Icon Name="@(backup.Scope == BackupScope.Full ? "hard-drive" : "database")" Size="IconSize.Small" />
                                                    </div>
                                                }
                                                <div>
                                                    <div class="font-medium text-nebula-text-primary flex items-center gap-2">
                                                        @backup.Name
                                                        @if (isRestoring)
                                                        {
                                                            <span class="text-sm text-nebula-warning">Restoring...</span>
                                                        }
                                                    </div>
                                                    <div class="text-sm text-nebula-text-muted flex items-center gap-2">
                                                        <span>@FormatBytes(backup.FileSizeBytes)</span>
                                                        <span class="text-nebula-text-muted">•</span>
                                                        <span>@backup.Scope backup</span>
                                                        <span class="text-nebula-text-muted">•</span>
                                                        <span>@FormatRelativeTime(backup.CreatedAt)</span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <StatusBadge Status="@GetBackupStatusType(backup.Status)"
                                                             Text="@backup.Status.ToString()"
                                                             ShowDot="true"
                                                             Size="StatusBadge.BadgeSize.Small" />
                                                <Button Variant="ButtonVariant.Ghost"
                                                        Size="ButtonSize.Small"
                                                        IconName="download"
                                                        IconOnly="true"
                                                        Disabled="@(backup.Status != BackupStatus.Completed || isRestoring)"
                                                        OnClick="@(() => DownloadBackup(backup))"
                                                        title="Download" />
                                                <Button Variant="ButtonVariant.Ghost"
                                                        Size="ButtonSize.Small"
                                                        IconName="rotate-ccw"
                                                        IconOnly="true"
                                                        Disabled="@(backup.Status != BackupStatus.Completed || _server.Status != ServerStatus.Stopped && _server.Status != ServerStatus.Unknown || _restoringBackupId.HasValue)"
                                                        OnClick="@(() => ShowRestoreConfirm(backup))"
                                                        title="@(_server.Status != ServerStatus.Stopped && _server.Status != ServerStatus.Unknown ? "Stop server to restore" : "Restore")" />
                                                <Button Variant="ButtonVariant.Ghost"
                                                        Size="ButtonSize.Small"
                                                        IconName="trash-2"
                                                        IconOnly="true"
                                                        Disabled="@isRestoring"
                                                        OnClick="@(() => DeleteBackup(backup))"
                                                        title="Delete" />
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    break;

                case "Settings":
                    <div class="space-y-6">
                        <Card>
                            <Header>
                                <h2 class="text-base font-medium text-nebula-text-primary">Server Configuration</h2>
                            </Header>
                            <ChildContent>
                                <div class="text-nebula-text-muted text-sm">
                                    <p>Edit server configuration, ports, and deployment settings.</p>
                                    <Button Variant="ButtonVariant.Secondary"
                                            Text="Edit Server"
                                            IconName="pencil"
                                            Class="mt-4"
                                            OnClick="EditSettings" />
                                </div>
                            </ChildContent>
                        </Card>

                        @* Docker Container Management *@
                        @if (_server.DeploymentType == ServerDeploymentType.Docker)
                        {
                            <Card>
                                <Header>
                                    <h2 class="text-base font-medium text-nebula-text-primary">Docker Container</h2>
                                </Header>
                                <ChildContent>
                                    <div class="space-y-4">
                                        <div class="flex items-center justify-between">
                                            <div>
                                                <p class="text-nebula-text-primary font-medium">Recreate Container</p>
                                                <p class="text-sm text-nebula-text-muted mt-0.5">
                                                    Delete and recreate the Docker container. Useful if container settings need to be updated.
                                                    Server files are preserved.
                                                </p>
                                            </div>
                                            <Button Variant="ButtonVariant.Secondary"
                                                    Text="Recreate"
                                                    IconName="refresh-cw"
                                                    Loading="_recreatingContainer"
                                                    Disabled="@(_server.Status == ServerStatus.Running || _server.Status == ServerStatus.Starting)"
                                                    OnClick="RecreateContainer" />
                                        </div>
                                        @if (!string.IsNullOrEmpty(_server.DockerContainerId))
                                        {
                                            <div class="text-xs text-nebula-text-muted pt-2 border-t border-nebula-border-subtle">
                                                <span>Container ID: </span>
                                                <code class="bg-nebula-bg-tertiary px-1.5 py-0.5 rounded">@_server.DockerContainerId[..Math.Min(12, _server.DockerContainerId.Length)]</code>
                                            </div>
                                        }
                                    </div>
                                </ChildContent>
                            </Card>
                        }

                        @* Startup Script Configuration (Minecraft only - both Native and Docker) *@
                        @if (_server.GameName == "Minecraft: Java Edition" && (_server.NativeConfig != null || _server.DeploymentType == ServerDeploymentType.Docker))
                        {
                            <Card>
                                <Header>
                                    <h2 class="text-base font-medium text-nebula-text-primary">Startup Method</h2>
                                </Header>
                                <ChildContent>
                                    <div class="space-y-4">
                                        <p class="text-sm text-nebula-text-muted">
                                            @if (_server.DeploymentType == ServerDeploymentType.Docker)
                                            {
                                                <text>Choose a startup script. The script will be parsed and the Java command will be extracted for the Docker container.</text>
                                            }
                                            else
                                            {
                                                <text>Choose how to start this server. Modpacks often include custom startup scripts with optimized JVM settings.</text>
                                            }
                                        </p>

                                        <div class="flex items-center gap-3">
                                            <Toggle Value="_useStartupScript"
                                                    ValueChanged="HandleStartupScriptToggle" />
                                            <span class="text-sm text-nebula-text-secondary">
                                                @if (_server.DeploymentType == ServerDeploymentType.Docker)
                                                {
                                                    <text>Use startup script (parsed for Docker)</text>
                                                }
                                                else
                                                {
                                                    <text>Use startup script instead of jar file</text>
                                                }
                                            </span>
                                        </div>

                                        @if (_useStartupScript)
                                        {
                                            <div class="space-y-3">
                                                @if (_detectedScripts.Count > 0)
                                                {
                                                    <div>
                                                        <label class="block text-sm font-medium text-nebula-text-secondary mb-2">Detected Scripts</label>
                                                        <div class="grid grid-cols-2 gap-2">
                                                            @foreach (var script in _detectedScripts)
                                                            {
                                                                <button type="button"
                                                                        class="@($"p-3 rounded-nebula border text-left transition-colors {(_startupScriptPath == script ? "border-nebula-accent bg-nebula-accent/10" : "border-nebula-border bg-nebula-bg-secondary hover:border-nebula-border-subtle")}")"
                                                                        @onclick="@(() => SelectStartupScript(script))">
                                                                    <div class="flex items-center gap-2">
                                                                        <Icon Name="file-code" Size="IconSize.Small" Class="@(_startupScriptPath == script ? "text-nebula-accent" : "text-nebula-text-muted")" />
                                                                        <span class="text-sm text-nebula-text-primary">@script</span>
                                                                    </div>
                                                                </button>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="flex items-center gap-2 text-sm text-nebula-warning">
                                                        <Icon Name="alert-triangle" Size="IconSize.Small" />
                                                        <span>No startup scripts detected in the server directory.</span>
                                                    </div>
                                                }

                                                <div>
                                                    <label class="block text-sm font-medium text-nebula-text-secondary mb-1">Custom Script Path</label>
                                                    <input type="text"
                                                           @bind="_startupScriptPath"
                                                           placeholder="e.g., start.bat or run.sh"
                                                           class="input" />
                                                    <p class="text-xs text-nebula-text-muted mt-1">Enter a custom path if your script has a different name.</p>
                                                </div>

                                                @if (_server.DeploymentType == ServerDeploymentType.Docker)
                                                {
                                                    <div class="bg-nebula-bg-tertiary rounded-nebula p-3 text-xs text-nebula-text-muted">
                                                        <Icon Name="info" Size="IconSize.Small" Class="inline mr-1" />
                                                        Docker will parse the script and extract the Java command. Windows .bat files are automatically converted for Linux containers.
                                                    </div>
                                                }
                                            </div>
                                        }

                                        <div class="flex items-center gap-2 pt-2">
                                            <Button Variant="ButtonVariant.Primary"
                                                    Text="Save Startup Settings"
                                                    Loading="_savingStartupSettings"
                                                    OnClick="SaveStartupSettings" />
                                            @if (_startupSettingsSaved)
                                            {
                                                <span class="text-sm text-nebula-success flex items-center gap-1">
                                                    <Icon Name="check" Size="IconSize.Small" />
                                                    Saved
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </ChildContent>
                            </Card>
                        }

                        @* RCON Configuration *@
                        <Card>
                            <Header>
                                <div class="flex items-center gap-2">
                                    <Icon Name="terminal" Size="IconSize.Small" Class="text-nebula-text-muted" />
                                    <h2 class="text-base font-medium text-nebula-text-primary">RCON Configuration</h2>
                                </div>
                            </Header>
                            <ChildContent>
                                <div class="space-y-4">
                                    <p class="text-sm text-nebula-text-muted">
                                        RCON (Remote Console) allows sending commands to the server. For Docker servers, RCON is the recommended method for command execution.
                                    </p>

                                    <div class="flex items-center justify-between">
                                        <div>
                                            <p class="text-nebula-text-primary font-medium">Enable RCON</p>
                                            <p class="text-xs text-nebula-text-muted">Use RCON protocol for sending commands</p>
                                        </div>
                                        <Toggle Value="_rconEnabled" ValueChanged="OnRconEnabledChanged" />
                                    </div>

                                    @if (_rconEnabled)
                                    {
                                        <div class="grid grid-cols-2 gap-4">
                                            <div>
                                                <label class="block text-sm font-medium text-nebula-text-secondary mb-1">Host</label>
                                                <input type="text"
                                                       class="w-full px-3 py-2 bg-nebula-bg-secondary border border-nebula-border rounded-nebula text-nebula-text-primary focus:outline-none focus:border-nebula-accent"
                                                       placeholder="127.0.0.1"
                                                       @bind="_rconHost"
                                                       @bind:event="oninput" />
                                            </div>
                                            <div>
                                                <label class="block text-sm font-medium text-nebula-text-secondary mb-1">Port</label>
                                                <input type="number"
                                                       class="w-full px-3 py-2 bg-nebula-bg-secondary border border-nebula-border rounded-nebula text-nebula-text-primary focus:outline-none focus:border-nebula-accent"
                                                       placeholder="25575"
                                                       @bind="_rconPort" />
                                            </div>
                                        </div>

                                        <div>
                                            <label class="block text-sm font-medium text-nebula-text-secondary mb-1">Password</label>
                                            <input type="password"
                                                   class="w-full px-3 py-2 bg-nebula-bg-secondary border border-nebula-border rounded-nebula text-nebula-text-primary focus:outline-none focus:border-nebula-accent"
                                                   placeholder="Enter RCON password"
                                                   @bind="_rconPassword"
                                                   @bind:event="oninput" />
                                            <p class="text-xs text-nebula-text-muted mt-1">Must match the rcon.password in your server.properties file</p>
                                        </div>
                                    }

                                    <div class="flex items-center gap-2 pt-2">
                                        <Button Variant="ButtonVariant.Primary"
                                                Text="Save RCON Settings"
                                                Loading="_savingRconSettings"
                                                OnClick="SaveRconSettings" />
                                        @if (_rconSettingsSaved)
                                        {
                                            <span class="text-sm text-nebula-success flex items-center gap-1">
                                                <Icon Name="check" Size="IconSize.Small" />
                                                Saved
                                            </span>
                                        }
                                    </div>
                                </div>
                            </ChildContent>
                        </Card>

                        <Card Class="border-nebula-error/30">
                            <Header>
                                <h2 class="text-base font-medium text-nebula-error">Danger Zone</h2>
                            </Header>
                            <ChildContent>
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-nebula-text-primary font-medium">Delete Server</p>
                                        <p class="text-sm text-nebula-text-muted mt-0.5">Permanently remove this server configuration. Files on disk will not be deleted.</p>
                                    </div>
                                    <Button Variant="ButtonVariant.Danger"
                                            Text="Delete"
                                            Disabled="@(_server.Status != ServerStatus.Stopped && _server.Status != ServerStatus.Unknown && _server.Status != ServerStatus.Crashed)"
                                            OnClick="@(() => _showDeleteConfirm = true)" />
                                </div>
                            </ChildContent>
                        </Card>
                    </div>
                    break;
            }
        </div>
    }
</div>

@* Delete Confirmation Modal *@
@if (_showDeleteConfirm && _server != null)
{
    <Modal IsOpen="true" OnClose="@(() => _showDeleteConfirm = false)" Size="ModalSize.Small">
        <Header>
            <h3 class="text-lg font-medium text-nebula-text-primary">Delete Server</h3>
        </Header>
        <Body>
            <p class="text-nebula-text-secondary">
                Are you sure you want to delete <strong class="text-nebula-text-primary">@_server.Name</strong>?
            </p>
            <p class="text-sm text-nebula-text-muted mt-2">This action cannot be undone.</p>

            <div class="mt-4 space-y-3">
                @if (_server.DeploymentType == ServerDeploymentType.Docker && !string.IsNullOrEmpty(_server.DockerContainerId))
                {
                    <label class="flex items-center gap-3 p-3 rounded-nebula bg-nebula-bg-secondary border border-nebula-border cursor-pointer hover:border-nebula-border-subtle transition-colors">
                        <input type="checkbox" @bind="_deleteContainer" class="w-4 h-4 rounded border-nebula-border text-nebula-accent focus:ring-nebula-accent" />
                        <div>
                            <div class="text-sm font-medium text-nebula-text-primary">Remove Docker container</div>
                            <div class="text-xs text-nebula-text-muted">Delete the Docker container associated with this server</div>
                        </div>
                    </label>
                }

                <label class="flex items-center gap-3 p-3 rounded-nebula bg-nebula-bg-secondary border border-nebula-border cursor-pointer hover:border-nebula-border-subtle transition-colors">
                    <input type="checkbox" @bind="_deleteFiles" class="w-4 h-4 rounded border-nebula-border text-nebula-accent focus:ring-nebula-accent" />
                    <div>
                        <div class="text-sm font-medium text-nebula-text-primary">Delete server files</div>
                        <div class="text-xs text-nebula-text-muted">Permanently delete all files at: @_server.InstallPath</div>
                    </div>
                </label>

                @if (_deleteFiles)
                {
                    <div class="p-3 rounded-nebula bg-red-500/10 border border-red-500/30">
                        <p class="text-sm text-red-400 flex items-center gap-2">
                            <Icon Name="alert-triangle" Size="IconSize.Small" />
                            Warning: This will permanently delete all server files including worlds, configs, and mods.
                        </p>
                    </div>
                }
            </div>
        </Body>
        <Footer>
            <div class="flex items-center justify-end gap-3">
                <Button Variant="ButtonVariant.Secondary" Text="Cancel" OnClick="@(() => { _showDeleteConfirm = false; _deleteFiles = false; _deleteContainer = false; })" />
                <Button Variant="ButtonVariant.Danger" Text="Delete Server" Loading="_deleting" OnClick="DeleteServer" />
            </div>
        </Footer>
    </Modal>
}

@* Create Backup Modal *@
@if (_showCreateBackupModal && _server != null)
{
    <Modal IsOpen="true" OnClose="CloseCreateBackupModal" Size="ModalSize.Medium">
        <Header>
            <h3 class="text-lg font-medium text-nebula-text-primary">Create Backup</h3>
        </Header>
        <Body>
            <div class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-nebula-text-secondary mb-1">Backup Type</label>
                    <div class="grid grid-cols-2 gap-3">
                        <button type="button"
                                class="@($"p-4 rounded-nebula border text-left transition-colors {(_createBackupScope == BackupScope.Full ? "border-nebula-accent bg-nebula-accent/10" : "border-nebula-border bg-nebula-bg-secondary hover:border-nebula-border-subtle")}")"
                                @onclick="@(() => _createBackupScope = BackupScope.Full)">
                            <div class="flex items-center gap-3">
                                <Icon Name="hard-drive" Size="IconSize.Medium" Class="@(_createBackupScope == BackupScope.Full ? "text-nebula-accent" : "text-nebula-text-muted")" />
                                <div>
                                    <div class="font-medium text-nebula-text-primary">Full Backup</div>
                                    <div class="text-xs text-nebula-text-muted">Entire server directory</div>
                                </div>
                            </div>
                        </button>
                        <button type="button"
                                class="@($"p-4 rounded-nebula border text-left transition-colors {(_createBackupScope == BackupScope.Selective ? "border-nebula-accent bg-nebula-accent/10" : "border-nebula-border bg-nebula-bg-secondary hover:border-nebula-border-subtle")}")"
                                @onclick="@(() => _createBackupScope = BackupScope.Selective)">
                            <div class="flex items-center gap-3">
                                <Icon Name="database" Size="IconSize.Medium" Class="@(_createBackupScope == BackupScope.Selective ? "text-nebula-accent" : "text-nebula-text-muted")" />
                                <div>
                                    <div class="font-medium text-nebula-text-primary">Selective Backup</div>
                                    <div class="text-xs text-nebula-text-muted">World, saves, and config only</div>
                                </div>
                            </div>
                        </button>
                    </div>
                </div>

                <div>
                    <label for="backupName" class="block text-sm font-medium text-nebula-text-secondary mb-1">Name (optional)</label>
                    <input type="text"
                           id="backupName"
                           @bind="_createBackupName"
                           placeholder="Leave blank for auto-generated name"
                           class="input" />
                </div>

                <div>
                    <label for="backupNotes" class="block text-sm font-medium text-nebula-text-secondary mb-1">Notes (optional)</label>
                    <textarea id="backupNotes"
                              @bind="_createBackupNotes"
                              rows="2"
                              placeholder="Add any notes about this backup..."
                              class="input resize-none"></textarea>
                </div>
            </div>
        </Body>
        <Footer>
            <div class="flex items-center justify-end gap-3">
                <Button Variant="ButtonVariant.Secondary" Text="Cancel" OnClick="CloseCreateBackupModal" />
                <Button Variant="ButtonVariant.Primary" Text="Create Backup" Loading="_creatingBackup" OnClick="CreateBackup" />
            </div>
        </Footer>
    </Modal>
}

@* Restore Backup Confirmation Modal *@
@if (_showRestoreConfirmModal && _backupToRestore != null && _server != null)

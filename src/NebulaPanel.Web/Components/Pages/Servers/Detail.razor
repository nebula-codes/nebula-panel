    private void StartResourceMonitoring()
    {
        _resourceTimer?.Dispose();
        _resourceTimer = new Timer(async _ =>
        {
            // Prevent concurrent DbContext access
            if (_resourceMonitoringInProgress) return;
            _resourceMonitoringInProgress = true;

            try
            {
                if (_server?.Status == ServerStatus.Running)
                {
                    var result = await ServerService.GetResourceUsageAsync(ServerId);
                    if (result.IsSuccess)

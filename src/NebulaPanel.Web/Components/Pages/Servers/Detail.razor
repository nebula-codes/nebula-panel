    }

    private async Task SaveRconSettings()
    {
        if (_server is null) return;

        _savingRconSettings = true;
        _rconSettingsSaved = false;

        try
        {
            // Sync additional ports with RCON config to ensure container port mappings match
            var updatedAdditionalPorts = new Dictionary<string, int>(_server.AdditionalPorts);
            if (_rconEnabled)
            {
                updatedAdditionalPorts["rcon"] = _rconPort;
            }
            else
            {
                updatedAdditionalPorts.Remove("rcon");
            }

            var updateRequest = new UpdateGameServerRequest(
                _server.Name,
                _server.Description,
                null, // Keep existing icon
                _server.InstallPath,
                _server.PrimaryPort,
                updatedAdditionalPorts,
                _server.BindAddress,
                _server.DockerConfig is not null ? new DockerConfigurationRequest(
                    _server.DockerConfig.Image,
                    _server.DockerConfig.Tag,
                    _server.DockerConfig.EnvironmentVariables,
                    _server.DockerConfig.Volumes?.Select(v => new VolumeMountRequest(v.HostPath, v.ContainerPath, v.ReadOnly)).ToList(),
                    _server.DockerConfig.Ports?.Select(p => new PortMappingRequest(p.HostPort, p.ContainerPort, p.Protocol)).ToList(),
                    _server.DockerConfig.Network,
                    _server.DockerConfig.Limits is not null ? new ResourceLimitsRequest(
                        _server.DockerConfig.Limits.MaxMemoryMb,
                        _server.DockerConfig.Limits.MaxCpuPercent,
                        _server.DockerConfig.Limits.MaxDiskMb,
                        _server.DockerConfig.Limits.MaxNetworkMbps) : null,
                    _server.DockerConfig.RestartPolicy
                ) : null,
                _server.NativeConfig is not null ? new NativeConfigurationRequest(
                    _server.NativeConfig.WorkingDirectory,
                    _server.NativeConfig.ExecutablePath,
                    _server.NativeConfig.Arguments,
                    _server.NativeConfig.EnvironmentVariables,
                    _server.NativeConfig.JavaPath,
                    _server.NativeConfig.JavaArguments,
                    _server.NativeConfig.RunAsService,
                    _server.NativeConfig.RunAsUser,
                    _server.NativeConfig.UseStartupScript,
                    _server.NativeConfig.StartupScriptPath
                ) : null,
                // Updated RCON config
                new RconConfigurationRequest(
                    _rconEnabled,
                    RconProtocolType.Minecraft,
                    _rconHost,
                    _rconPort,
                    _rconPassword,
                    false,
                    null,
                    10
                ),
                _server.ResourceLimits is not null ? new ResourceLimitsRequest(
                    _server.ResourceLimits.MaxMemoryMb,
                    _server.ResourceLimits.MaxCpuPercent,
                    _server.ResourceLimits.MaxDiskMb,
                    _server.ResourceLimits.MaxNetworkMbps
                ) : null
            );

            var result = await ServerService.UpdateServerAsync(ServerId, updateRequest);

            if (result.IsSuccess)
            {
                _rconSettingsSaved = true;

                // Update server.properties if it exists (for Minecraft servers)
                var serverPropertiesUpdated = await UpdateServerPropertiesRconAsync();

                // Check if port changed and server is Docker - remind about container recreation
                var portChanged = _server.RconConfig?.Port != _rconPort ||
                                  _server.AdditionalPorts.GetValueOrDefault("rcon") != _rconPort;
                if (_server.DeploymentType == ServerDeploymentType.Docker && portChanged)
                {
                    var msg = serverPropertiesUpdated
                        ? "RCON configuration and server.properties updated. Please stop and recreate the container for port changes to take effect."
                        : "RCON configuration updated. Please stop and recreate the container for port changes to take effect.";
                    ToastService.ShowSuccess("RCON settings saved", msg);
                }
                else
                {
                    var msg = serverPropertiesUpdated
                        ? "RCON configuration and server.properties updated successfully."
                        : "RCON configuration updated successfully.";
                    ToastService.ShowSuccess("RCON settings saved", msg);
                }

                await LoadServerAsync(); // Refresh to get updated config
            }
            else
            {
                _actionError = result.Error;
                ToastService.ShowError("Save failed", result.Error ?? "Failed to save RCON settings.");
            }
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
            ToastService.ShowError("Error", ex.Message);
        }
        finally
        {
            _savingRconSettings = false;
        }
    }

    /// <summary>
    /// Updates server.properties and default-server.properties files with the current RCON settings.
    /// Creates RCON entries if they don't exist. Returns true if any file was updated.
    /// </summary>
    private async Task<bool> UpdateServerPropertiesRconAsync()
    {
        if (_server is null) return false;

        var updated = false;

        // Update both server.properties and default-server.properties (for modpacks that use it)
        var filesToUpdate = new[]
        {
            Path.Combine(_server.InstallPath, "server.properties"),
            Path.Combine(_server.InstallPath, "default-server.properties")
        };

        foreach (var filePath in filesToUpdate)
        {
            if (await UpdatePropertiesFileAsync(filePath))
            {
                updated = true;
            }
        }

        return updated;
    }

    /// <summary>
    /// Updates a single properties file with RCON settings.
    /// Adds missing RCON properties if they don't exist.
    /// </summary>
    private async Task<bool> UpdatePropertiesFileAsync(string filePath)
    {
        if (!File.Exists(filePath)) return false;

        try
        {
            var lines = await File.ReadAllLinesAsync(filePath);
            var newLines = new List<string>();
            var hasEnableRcon = false;
            var hasRconPort = false;
            var hasRconPassword = false;

            foreach (var line in lines)
            {
                var trimmed = line.Trim();
                if (trimmed.StartsWith("enable-rcon="))
                {
                    newLines.Add($"enable-rcon={(_rconEnabled ? "true" : "false")}");
                    hasEnableRcon = true;
                }
                else if (trimmed.StartsWith("rcon.port="))
                {
                    newLines.Add($"rcon.port={_rconPort}");
                    hasRconPort = true;
                }
                else if (trimmed.StartsWith("rcon.password="))
                {
                    newLines.Add($"rcon.password={_rconPassword}");
                    hasRconPassword = true;
                }
                else
                {
                    newLines.Add(line);
                }
            }

            // Add missing RCON properties at the end
            if (!hasEnableRcon)
            {
                newLines.Add($"enable-rcon={(_rconEnabled ? "true" : "false")}");
            }
            if (!hasRconPort)
            {
                newLines.Add($"rcon.port={_rconPort}");
            }
            if (!hasRconPassword)
            {
                newLines.Add($"rcon.password={_rconPassword}");
            }

            await File.WriteAllLinesAsync(filePath, newLines);
            return true;
        }
        catch (Exception ex)
        {
            // Log but don't fail the save operation
            Console.WriteLine($"Failed to update {Path.GetFileName(filePath)}: {ex.Message}");
        }

        return false;
    }

    private static StatusType GetStatusType(ServerStatus status) => status switch
    {
        ServerStatus.Running => StatusType.Success,
        ServerStatus.Starting => StatusType.Warning,
        ServerStatus.Stopping => StatusType.Warning,
        ServerStatus.Stopped => StatusType.Neutral,
        ServerStatus.Crashed => StatusType.Error,
        ServerStatus.Updating => StatusType.Info,
        ServerStatus.Installing => StatusType.Info,
        _ => StatusType.Neutral
    };

    private static string FormatRelativeTime(DateTime dateTime)
    {
        var diff = DateTime.UtcNow - dateTime;

        if (diff.TotalMinutes < 1)
            return "Just now";
        if (diff.TotalMinutes < 60)
            return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24)
            return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7)
            return $"{(int)diff.TotalDays}d ago";

        return dateTime.ToString("MMM d");
    }

    private static string FormatBytes(long bytes)
    {
        string[] sizes = ["B", "KB", "MB", "GB", "TB"];
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private static string FormatUptime(TimeSpan uptime)
    {
        if (uptime.TotalDays >= 1)
            return $"{(int)uptime.TotalDays}d {uptime.Hours}h {uptime.Minutes}m";
        if (uptime.TotalHours >= 1)
            return $"{(int)uptime.TotalHours}h {uptime.Minutes}m";
        if (uptime.TotalMinutes >= 1)
            return $"{(int)uptime.TotalMinutes}m {uptime.Seconds}s";
        return $"{uptime.Seconds}s";
    }

    private static string TruncatePath(string path)
    {
        if (path.Length <= 30) return path;
        return "..." + path[^27..];
    }

    private async Task LoadResourceHistoryAsync()
    {
        _loadingResourceHistory = true;
        StateHasChanged();

        try
        {
            var allHistory = await DashboardService.GetResourceHistoryAsync(_resourceTimeRange);
            var serverHistory = allHistory.FirstOrDefault(h => h.ServerId == ServerId);
            _serverResourceHistory = serverHistory?.DataPoints ?? [];
            _resourceHistoryLoaded = true;
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to load resource history: {ex.Message}");
        }
        finally
        {
            _loadingResourceHistory = false;
            StateHasChanged();
        }
    }

    private async Task OnResourceTimeRangeChanged(TimeSpan range)
    {
        _resourceTimeRange = range;
        _resourceHistoryLoaded = false;
        await LoadResourceHistoryAsync();
    }

    private string GetResourceTimeRangeButtonClass(TimeSpan range)
    {
        var baseClass = "px-2 py-1 text-xs rounded transition-colors";
        if (_resourceTimeRange == range)
        {
            return $"{baseClass} bg-nebula-accent text-white";
        }
        return $"{baseClass} text-nebula-text-muted hover:bg-nebula-bg-tertiary";
    }

    public void Dispose()
    {
        StopConsoleStream();
        StopResourceMonitoring();
    }

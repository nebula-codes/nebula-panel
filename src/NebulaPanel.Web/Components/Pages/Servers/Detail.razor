</Modal>

@code {
    [Parameter]
    public Guid ServerId { get; set; }

    private string[] _tabs => GetTabs();
    private string _activeTab = "Overview";

    private string[] GetTabs() => _server?.HytaleInfo != null
        ? ["Overview", "Console", "Files", "Mods", "Worlds", "Updates", "Config", "Schedule", "Backups", "Settings"]
        : ["Overview", "Console", "Files", "Mods", "Config", "Schedule", "Backups", "Settings"];

    /// <summary>
    /// Returns true if this server is a Terraria/tModLoader server.
    /// </summary>
    private bool IsTerrariaServer() =>
        _server?.GameName?.Contains("Terraria", StringComparison.OrdinalIgnoreCase) == true ||
        _server?.GameName?.Contains("tModLoader", StringComparison.OrdinalIgnoreCase) == true;

    private GameServerDto? _server;
    private bool _loading = true;
    private string? _error;
    private string? _actionError;
    private bool _showDeleteConfirm;
    private bool _deleting;
    private bool _deleteFiles;
    private bool _deleteContainer;

    private bool _starting;
    private bool _stopping;
    private bool _restarting;
    private bool _killing;
    private bool _recreatingContainer;
    private bool _hytaleUpdating;
    private bool _actionInProgress => _starting || _stopping || _restarting || _killing || _recreatingContainer || _hytaleUpdating;

    private List<string> _consoleLines = [];
    private string _commandInput = "";
    private bool _sendingCommand;
    private ElementReference _consoleOutput;
    private CancellationTokenSource? _consoleCts;
    private bool _autoScroll = true;
    private bool _showConsoleSearch;
    private string _consoleSearchQuery = "";

    private ResourceUsage? _resourceUsage;
    private Timer? _resourceTimer;
    private bool _resourceMonitoringInProgress;

    // Resource History
    private IReadOnlyList<ResourceDataPointDto> _serverResourceHistory = [];
    private bool _loadingResourceHistory;
    private bool _resourceHistoryLoaded;
    private TimeSpan _resourceTimeRange = TimeSpan.FromHours(1);

    // Mods
    private List<ServerModDto> _installedMods = [];
    private List<ModUpdateInfo> _availableUpdates = [];
    private bool _loadingMods;
    private bool _modsLoaded;
    private string _modsSubTab = "installed";
    private ServerModDto? _selectedModForDetails;
    private ServerModDto? _modToDelete;
    private bool _deletingMod;

    // Scheduled Tasks
    private List<ScheduledTaskListItemDto> _scheduledTasks = [];
    private bool _loadingTasks;
    private bool _tasksLoaded;

    // Backups
    private List<BackupListItemDto> _backups = [];
    private BackupSummaryDto? _backupSummary;
    private bool _loadingBackups;
    private bool _backupsLoaded;
    private string? _fileExplorerPath;
    private bool _creatingBackup;
    private bool _showCreateBackupModal;
    private BackupScope _createBackupScope = BackupScope.Full;
    private string? _createBackupName;
    private string? _createBackupNotes;
    private Guid? _restoringBackupId;
    private bool _showRestoreConfirmModal;
    private BackupListItemDto? _backupToRestore;

    // Modpack Updates
    private ModpackUpdateInfo? _modpackUpdateInfo;
    private bool _checkingModpackUpdates;
    private bool _showUpdateModal;
    private bool _showUpdateProgressModal;
    private bool _updatingModpack;
    private ModpackUpdateProgressDto? _modpackUpdateProgress;
    private CancellationTokenSource? _updateCts;

    // Startup Script Settings
    private bool _useStartupScript;
    private string? _startupScriptPath;
    private List<string> _detectedScripts = [];
    private bool _savingStartupSettings;
    private bool _startupSettingsSaved;

    // RCON Settings
    private bool _rconEnabled;
    private string _rconHost = "127.0.0.1";
    private int _rconPort = 25575;
    private string _rconPassword = "";
    private bool _savingRconSettings;
    private bool _rconSettingsSaved;

    protected override async Task OnInitializedAsync()
    {
        await LoadServerAsync();

        // Load resource history for Overview chart
        _ = LoadResourceHistoryAsync();

        // Check for modpack updates if a modpack is installed
        if (_server?.InstalledModpack is not null)
        {
            // Check if we have cached update info or if it's stale (> 1 hour)
            var needsCheck = !_server.InstalledModpack.LastUpdateCheckAt.HasValue ||
                             DateTime.UtcNow - _server.InstalledModpack.LastUpdateCheckAt.Value > TimeSpan.FromHours(1);

            if (needsCheck)
            {
                // Check in background (don't await)
                _ = CheckForModpackUpdates();
            }
            else if (_server.InstalledModpack.UpdateAvailable &&
                     _server.InstalledModpack.DismissedVersionId != _server.InstalledModpack.LatestVersionId)
            {
                // Use cached update info to build ModpackUpdateInfo for display
                _modpackUpdateInfo = new ModpackUpdateInfo
                {
                    CurrentVersionId = _server.InstalledModpack.VersionId,
                    CurrentVersionName = _server.InstalledModpack.VersionName ?? _server.InstalledModpack.VersionId,
                    LatestVersionId = _server.InstalledModpack.LatestVersionId!,
                    LatestVersionName = _server.InstalledModpack.LatestVersionName!,
                    ReleasedAt = _server.InstalledModpack.LatestVersionReleasedAt ?? DateTime.UtcNow,
                    CurrentMinecraftVersion = _server.InstalledModpack.MinecraftVersion
                };
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _server?.Status == ServerStatus.Running)
        {
            StartConsoleStream();
            StartResourceMonitoring();
        }
        await Task.CompletedTask;
    }

    private static string? GetTabIcon(string tab) => tab switch
    {
        "Overview" => "layout-dashboard",
        "Console" => "terminal",
        "Files" => "folder",
        "Worlds" => "globe",
        "Mods" => "package",
        "Updates" => "download",
        "Config" => "sliders",
        "Schedule" => "clock",
        "Backups" => "archive",
        "Settings" => "settings",
        _ => null
    };

    private async Task OnTabChanged()
    {
        if (_activeTab == "Mods" && !_modsLoaded)
        {
            await LoadModsAsync();
        }
        else if (_activeTab == "Schedule" && !_tasksLoaded)
        {
            await LoadTasksAsync();
        }
        else if (_activeTab == "Backups" && !_backupsLoaded)
        {
            await LoadBackupsAsync();
        }
    }

    private void NavigateToFilesTab(string? path)
    {
        _fileExplorerPath = path;
        _activeTab = "Files";
        StateHasChanged();
    }

    private async Task LoadModsAsync()
    {
        if (_server is null) return;

        try
        {
            _loadingMods = true;
            StateHasChanged();

            // Get server with game details for mod service
            var serverEntity = await ServerRepository.GetByIdWithGameAsync(ServerId);
            if (serverEntity is null) return;

            var installedMods = await ModService.GetInstalledAsync(serverEntity);
            _installedMods = installedMods.ToList();

            var updates = await ModService.CheckAllUpdatesAsync(serverEntity);
            _availableUpdates = updates.ToList();

            _modsLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load mods: {ex.Message}");
            ToastService.ShowError("Failed to load mods");
        }
        finally
        {
            _loadingMods = false;
            StateHasChanged();
        }
    }

    private async Task HandleModSelected(ModSearchItem mod)
    {
        // TODO: Show mod details modal or install dialog
        ToastService.ShowInfo($"Selected: {mod.Name}");
        await Task.CompletedTask;
    }

    private void ViewModDetails(ServerModDto mod)
    {
        _selectedModForDetails = mod;
    }

    private void CloseModDetailsModal()
    {
        _selectedModForDetails = null;
    }

    private void ConfirmDeleteMod(ServerModDto mod)
    {
        _modToDelete = mod;
    }

    private void CancelDeleteMod()
    {
        _modToDelete = null;
        _deletingMod = false;
    }

    private async Task DeleteModConfirmed()
    {
        if (_modToDelete == null || _server == null) return;

        _deletingMod = true;
        StateHasChanged();

        try
        {
            var serverEntity = await ServerRepository.GetByIdAsync(ServerId);
            if (serverEntity != null)
            {
                var result = await ModService.UninstallAsync(serverEntity, _modToDelete.Id);
                if (result.IsSuccess)
                {
                    _installedMods.RemoveAll(m => m.Id == _modToDelete.Id);
                    ToastService.ShowSuccess($"Deleted {_modToDelete.Name}");
                }
                else
                {
                    ToastService.ShowError($"Failed to delete mod: {result.Error}");
                }
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Failed to delete mod: {ex.Message}");
        }
        finally
        {
            _modToDelete = null;
            _deletingMod = false;
            StateHasChanged();
        }
    }

    private async Task ToggleModEnabled(ServerModDto mod)
    {
        // Toggle mod enabled state (not yet implemented in service)
        ToastService.ShowInfo("Toggle mod enabled is not yet implemented");
        await Task.CompletedTask;
    }

    private async Task LoadTasksAsync()
    {
        if (_server is null) return;

        try
        {
            _loadingTasks = true;
            StateHasChanged();

            var tasks = await TaskService.GetTasksByServerIdAsync(ServerId);
            _scheduledTasks = tasks.ToList();
            _tasksLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load scheduled tasks: {ex.Message}");
            ToastService.ShowError("Failed to load scheduled tasks");
        }
        finally
        {
            _loadingTasks = false;
            StateHasChanged();
        }
    }

    private async Task ToggleTaskEnabled(ScheduledTaskListItemDto task)
    {
        var result = task.IsEnabled
            ? await TaskService.DisableTaskAsync(task.Id)
            : await TaskService.EnableTaskAsync(task.Id);

        if (result.IsSuccess)
        {
            await LoadTasksAsync();
        }
    }

    private async Task RunTaskNow(ScheduledTaskListItemDto task)
    {
        await TaskService.RunTaskNowAsync(task.Id);
    }

    private async Task LoadBackupsAsync()
    {
        if (_server is null) return;

        try
        {
            _loadingBackups = true;
            StateHasChanged();

            var backups = await BackupService.GetBackupsByServerIdAsync(ServerId);
            _backups = backups.ToList();

            _backupSummary = await BackupService.GetServerBackupSummaryAsync(ServerId);

            _backupsLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load backups: {ex.Message}");
            ToastService.ShowError("Failed to load backups");
        }
        finally
        {
            _loadingBackups = false;
            StateHasChanged();
        }
    }

    private void CloseCreateBackupModal()
    {
        _showCreateBackupModal = false;
        _createBackupScope = BackupScope.Full;
        _createBackupName = null;
        _createBackupNotes = null;
    }

    private async Task CreateBackup()
    {
        if (_server is null) return;

        _creatingBackup = true;
        try
        {
            Result<BackupDto> result;
            if (_createBackupScope == BackupScope.Full)
            {
                result = await BackupService.CreateFullBackupAsync(ServerId, _createBackupName, _createBackupNotes);
            }
            else
            {

@* Mod Details Modal *@
<Modal IsOpen="@(_selectedModForDetails != null)" Size="ModalSize.Medium" OnClose="CloseModDetailsModal">
    <Header>
        <span class="text-lg font-medium text-nebula-text-primary">Mod Details</span>
    </Header>
    <Body>
        @if (_selectedModForDetails != null)
        {
            <div class="space-y-4">
                @* Header with icon *@
                <div class="flex items-start gap-4">
                    @if (!string.IsNullOrEmpty(_selectedModForDetails.IconUrl))
                    {
                        <img src="@_selectedModForDetails.IconUrl" alt="@_selectedModForDetails.Name" class="w-16 h-16 object-cover rounded-lg" />
                    }
                    else
                    {
                        <div class="w-16 h-16 bg-nebula-bg-tertiary rounded-lg flex items-center justify-center">
                            <Icon Name="package" Size="IconSize.Large" Class="text-nebula-text-muted" />
                        </div>
                    }
                    <div>
                        <h3 class="text-xl font-semibold text-nebula-text-primary">@_selectedModForDetails.Name</h3>
                        <p class="text-sm text-nebula-text-muted">ID: @_selectedModForDetails.ModId</p>
                    </div>
                </div>

                @* Info grid *@
                <div class="grid grid-cols-2 gap-4 p-4 bg-nebula-bg-tertiary rounded-nebula">
                    <div>
                        <span class="text-xs text-nebula-text-muted uppercase">Version</span>
                        <p class="text-sm text-nebula-text-primary font-medium">@_selectedModForDetails.Version</p>
                    </div>
                    <div>
                        <span class="text-xs text-nebula-text-muted uppercase">Provider</span>
                        <p class="text-sm text-nebula-text-primary font-medium">@_selectedModForDetails.Provider</p>
                    </div>
                    <div>
                        <span class="text-xs text-nebula-text-muted uppercase">Installed</span>
                        <p class="text-sm text-nebula-text-primary font-medium">@_selectedModForDetails.InstalledAt.ToString("MMM d, yyyy")</p>
                    </div>
                    <div>
                        <span class="text-xs text-nebula-text-muted uppercase">Status</span>
                        <p class="text-sm font-medium @(_selectedModForDetails.IsEnabled ? "text-nebula-success" : "text-nebula-text-muted")">
                            @(_selectedModForDetails.IsEnabled ? "Enabled" : "Disabled")
                        </p>
                    </div>
                    @if (_selectedModForDetails.FileSizeBytes.HasValue)
                    {
                        <div>
                            <span class="text-xs text-nebula-text-muted uppercase">File Size</span>
                            <p class="text-sm text-nebula-text-primary font-medium">@FormatBytes(_selectedModForDetails.FileSizeBytes.Value)</p>
                        </div>
                    }
                </div>

                @* File path *@
                @if (!string.IsNullOrEmpty(_selectedModForDetails.LocalPath))
                {
                    <div>
                        <span class="text-xs text-nebula-text-muted uppercase">File Path</span>
                        <p class="text-sm text-nebula-text-secondary font-mono break-all">@_selectedModForDetails.LocalPath</p>
                    </div>
                }
            </div>
        }
    </Body>
    <Footer>
        <div class="flex justify-end gap-3">
            <Button Variant="ButtonVariant.Secondary" Text="Close" OnClick="CloseModDetailsModal" />
        </div>
    </Footer>
</Modal>

@* Delete Mod Confirmation Modal *@
<Modal IsOpen="@(_modToDelete != null)" Size="ModalSize.Small" OnClose="CancelDeleteMod">
    <Header>
        <span class="text-lg font-medium text-nebula-text-primary">Delete Mod</span>
    </Header>
    <Body>
        <div class="space-y-3">
            <p class="text-nebula-text-secondary">
                Are you sure you want to delete <strong class="text-nebula-text-primary">@_modToDelete?.Name</strong>?

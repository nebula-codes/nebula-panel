            await RefreshServerAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to check for modpack updates: {ex.Message}");
            ToastService.ShowError("Failed to check for modpack updates");
        }
        finally
        {
            _checkingModpackUpdates = false;

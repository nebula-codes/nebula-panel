    private async Task SaveStartupSettings()
    {
        if (_server is null) return;

        _savingStartupSettings = true;
        _startupSettingsSaved = false;

        try
        {
            // Build NativeConfigurationRequest - for Docker servers, create minimal config just for startup script
            NativeConfigurationRequest? nativeConfigRequest;
            if (_server.NativeConfig is not null)
            {
                nativeConfigRequest = new NativeConfigurationRequest(
                    _server.NativeConfig.WorkingDirectory,
                    _server.NativeConfig.ExecutablePath,
                    _server.NativeConfig.Arguments,
                    _server.NativeConfig.EnvironmentVariables,
                    _server.NativeConfig.JavaPath,
                    _server.NativeConfig.JavaArguments,
                    _server.NativeConfig.RunAsService,
                    _server.NativeConfig.RunAsUser,
                    _useStartupScript,
                    _startupScriptPath
                );
            }
            else if (_server.DeploymentType == ServerDeploymentType.Docker)
            {
                // For Docker servers without NativeConfig, create a minimal config just for startup script settings
                nativeConfigRequest = new NativeConfigurationRequest(
                    _server.InstallPath,  // WorkingDirectory
                    null,  // ExecutablePath
                    null,  // Arguments
                    null,  // EnvironmentVariables
                    null,  // JavaPath
                    null,  // JavaArguments
                    false, // RunAsService
                    null,  // RunAsUser
                    _useStartupScript,
                    _startupScriptPath
                );
            }
            else
            {
                return; // No config to save
            }

            // Create update request with current server settings plus new startup script settings
            var updateRequest = new UpdateGameServerRequest(
                _server.Name,
                _server.Description,
                null, // Keep existing icon
                _server.InstallPath,
                _server.PrimaryPort,
                _server.AdditionalPorts,
                _server.BindAddress,
                _server.DockerConfig is not null ? new DockerConfigurationRequest(
                    _server.DockerConfig.Image,
                    _server.DockerConfig.Tag,
                    _server.DockerConfig.EnvironmentVariables,
                    _server.DockerConfig.Volumes?.Select(v => new VolumeMountRequest(v.HostPath, v.ContainerPath, v.ReadOnly)).ToList(),
                    _server.DockerConfig.Ports?.Select(p => new PortMappingRequest(p.HostPort, p.ContainerPort, p.Protocol)).ToList(),
                    _server.DockerConfig.Network,
                    _server.DockerConfig.Limits is not null ? new ResourceLimitsRequest(
                        _server.DockerConfig.Limits.MaxMemoryMb,
                        _server.DockerConfig.Limits.MaxCpuPercent,
                        _server.DockerConfig.Limits.MaxDiskMb,
                        _server.DockerConfig.Limits.MaxNetworkMbps) : null,
                    _server.DockerConfig.RestartPolicy
                ) : null,
                nativeConfigRequest,
                _server.RconConfig is not null ? new RconConfigurationRequest(
                    _server.RconConfig.Enabled,
                    _server.RconConfig.Protocol,
                    _server.RconConfig.Host,
                    _server.RconConfig.Port,
                    _server.RconConfig.Password,
                    _server.RconConfig.UseWebSocket,
                    _server.RconConfig.WebRconPath,
                    _server.RconConfig.TimeoutSeconds
                ) : null,
                _server.ResourceLimits is not null ? new ResourceLimitsRequest(
                    _server.ResourceLimits.MaxMemoryMb,
                    _server.ResourceLimits.MaxCpuPercent,
                    _server.ResourceLimits.MaxDiskMb,
                    _server.ResourceLimits.MaxNetworkMbps
                ) : null
            );

            var result = await ServerService.UpdateServerAsync(ServerId, updateRequest);

            if (result.IsSuccess)
            {
                _startupSettingsSaved = true;
                await LoadServerAsync(); // Refresh to get updated config
            }
            else
            {
                _actionError = result.Error;
            }
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _savingStartupSettings = false;
        }
    }


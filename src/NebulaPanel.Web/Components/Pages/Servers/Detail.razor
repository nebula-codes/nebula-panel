        await RefreshServerAsync();
    }

    private async Task ExecuteModpackUpdate(ModpackUpdateOptions options)
    {
        if (_server is null || _modpackUpdateInfo is null) return;

        _showUpdateModal = false;
        _showUpdateProgressModal = true;
        _updatingModpack = true;
        _updateCts = new CancellationTokenSource();

        try
        {
            var serverEntity = await ServerRepository.GetByIdWithGameAsync(ServerId);
            if (serverEntity is null)
            {
                _modpackUpdateProgress = ModpackUpdateProgressDto.Failed("Server not found");
                return;
            }

            var progress = new Progress<ModpackUpdateProgressDto>(p =>
            {
                _modpackUpdateProgress = p;
                InvokeAsync(StateHasChanged);
            });

            var result = await ModpackUpdateService.UpdateModpackAsync(
                serverEntity,
                _modpackUpdateInfo.LatestVersionId,
                options,
                progress,
                _updateCts.Token);

            if (result.Success)
            {
                _modpackUpdateProgress = ModpackUpdateProgressDto.Completed();
                _modpackUpdateInfo = null;
                await RefreshServerAsync();
            }
            else
            {
                _modpackUpdateProgress = ModpackUpdateProgressDto.Failed(result.Error ?? "Unknown error");
            }
        }
        catch (OperationCanceledException)
        {
            _modpackUpdateProgress = ModpackUpdateProgressDto.Failed("Update cancelled");
        }
        catch (Exception ex)
        {
            _modpackUpdateProgress = ModpackUpdateProgressDto.Failed(ex.Message);
        }
        finally
        {
            _updatingModpack = false;
            StateHasChanged();
        }
    }

    private void CancelModpackUpdate()
    {
        _updateCts?.Cancel();
    }

    private void CloseUpdateProgressModal()
    {
        _showUpdateProgressModal = false;
        _modpackUpdateProgress = null;
    }

    private async Task RetryModpackUpdate()
    {
        // Close progress modal and reopen update modal
        _showUpdateProgressModal = false;
        _modpackUpdateProgress = null;

        // Re-check for updates
        await CheckForModpackUpdates();

        if (_modpackUpdateInfo != null)
        {
            _showUpdateModal = true;
        }
    }


@using NebulaPanel.Domain.Enums
@using NebulaPanel.Domain.Interfaces

<div class="mod-browser-datagrid">
    @if (Loading)
    {
        <div class="loading-skeleton">
            @for (var i = 0; i < 10; i++)
            {
                <div class="skeleton-row">
                    <div class="skeleton-cell skeleton-icon"></div>
                    <div class="skeleton-cell skeleton-name"></div>
                    <div class="skeleton-cell skeleton-author"></div>
                    <div class="skeleton-cell skeleton-type"></div>
                    <div class="skeleton-cell skeleton-downloads"></div>
                    <div class="skeleton-cell skeleton-updated"></div>
                    <div class="skeleton-cell skeleton-provider"></div>
                    <div class="skeleton-cell skeleton-actions"></div>
                </div>
            }
        </div>
    }
    else if (!Mods.Any())
    {
        <EmptyState IconName="search"
                    Heading="No mods found"
                    Description="Try a different search term or adjust your filters." />
    }
    else
    {
        <div class="datagrid-container">
            <table class="data-grid">
                <thead>
                    <tr>
                        <th class="col-icon"></th>
                        <th class="col-name sortable @GetSortClass("name")" @onclick="@(() => HandleSort("name"))">
                            Name
                            <Icon Name="@GetSortIcon("name")" Size="Icon.IconSize.XSmall" Class="sort-icon" />
                        </th>
                        <th class="col-author sortable @GetSortClass("author")" @onclick="@(() => HandleSort("author"))">
                            Author
                            <Icon Name="@GetSortIcon("author")" Size="Icon.IconSize.XSmall" Class="sort-icon" />
                        </th>
                        <th class="col-type">Type</th>
                        <th class="col-downloads sortable @GetSortClass("downloads")" @onclick="@(() => HandleSort("downloads"))">
                            Downloads
                            <Icon Name="@GetSortIcon("downloads")" Size="Icon.IconSize.XSmall" Class="sort-icon" />
                        </th>
                        <th class="col-updated sortable @GetSortClass("updated")" @onclick="@(() => HandleSort("updated"))">
                            Updated
                            <Icon Name="@GetSortIcon("updated")" Size="Icon.IconSize.XSmall" Class="sort-icon" />
                        </th>
                        <th class="col-provider">Source</th>
                        <th class="col-actions">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var mod in Mods)
                    {
                        var isInstalled = InstalledModIds.Contains(mod.Id);
                        var isBusy = BusyMods.Contains(mod.Id);

                        <tr class="@GetRowClasses(mod)" @onclick="() => HandleViewDetails(mod)">
                            @* Icon *@
                            <td class="col-icon">
                                @if (!string.IsNullOrEmpty(mod.IconUrl))
                                {
                                    <img src="@mod.IconUrl" alt="@mod.Name" class="mod-icon" loading="lazy" />
                                }
                                else
                                {
                                    <div class="mod-icon-placeholder">
                                        <Icon Name="package" Size="Icon.IconSize.Medium" />
                                    </div>
                                }
                            </td>

                            @* Name with installed badge *@
                            <td class="col-name">
                                <div class="name-cell">
                                    <span class="mod-name" title="@mod.Name">@mod.Name</span>
                                    @if (isInstalled)
                                    {
                                        <span class="installed-badge">
                                            <Icon Name="check" Size="Icon.IconSize.XSmall" Class="badge-icon" />
                                            Installed
                                        </span>
                                    }
                                </div>
                                @if (!string.IsNullOrEmpty(mod.Summary))
                                {
                                    <p class="mod-summary">@TruncateSummary(mod.Summary, 80)</p>
                                }
                            </td>

                            @* Author *@
                            <td class="col-author">
                                <span class="author-name">@(mod.Author ?? "Unknown")</span>
                            </td>

                            @* Type/Classification *@
                            <td class="col-type">
                                @{
                                    var classification = GetPrimaryCategory(mod.Categories);
                                }
                                <span class="classification-badge @GetCategoryBadgeClass(classification)">
                                    @GetClassificationIcon(classification)
                                    @classification
                                </span>
                            </td>

                            @* Downloads *@
                            <td class="col-downloads">
                                <span class="downloads-count">@FormatDownloads(mod.Downloads)</span>
                            </td>

                            @* Updated *@
                            <td class="col-updated">
                                <span class="date" title="@(mod.UpdatedAt?.ToString("F") ?? "Unknown")">
                                    @FormatRelativeDate(mod.UpdatedAt)
                                </span>
                            </td>

                            @* Provider *@
                            <td class="col-provider">
                                <span class="provider-badge provider-@mod.Provider.ToString().ToLowerInvariant()">
                                    @GetProviderDisplayName(mod.Provider)
                                </span>
                            </td>

                            @* Actions *@
                            <td class="col-actions" @onclick:stopPropagation="true">
                                <div class="action-buttons">
                                    <Button IconName="info"
                                            IconOnly="true"
                                            Variant="Button.ButtonVariant.Ghost"
                                            Size="Button.ButtonSize.Small"
                                            OnClick="@(() => HandleViewDetails(mod))"
                                            title="View details" />
                                    @if (isInstalled)
                                    {
                                        <Button Text="Installed"
                                                IconName="check"
                                                Variant="Button.ButtonVariant.Ghost"
                                                Size="Button.ButtonSize.Small"
                                                Disabled="true"
                                                Class="btn-installed" />
                                    }
                                    else
                                    {
                                        <Button Text="Install"
                                                IconName="download"
                                                Variant="Button.ButtonVariant.Primary"
                                                Size="Button.ButtonSize.Small"
                                                Loading="@isBusy"
                                                OnClick="@(() => HandleInstall(mod))" />
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Pagination Footer *@
        @if (TotalPages > 1)
        {
            <div class="datagrid-footer">
                <div class="datagrid-pagination-info">
                    Showing @StartIndex to @EndIndex of @TotalCount
                </div>
                <div class="datagrid-pagination">
                    <Button IconName="chevron-left"
                            IconOnly="true"
                            Variant="Button.ButtonVariant.Ghost"
                            Size="Button.ButtonSize.Small"
                            Disabled="@(CurrentPage <= 1)"
                            OnClick="@(() => HandlePageChange(CurrentPage - 1))"
                            title="Previous page" />

                    @foreach (var pageNum in GetPageNumbers())
                    {
                        <button class="page-btn @(pageNum == CurrentPage ? "active" : "")"
                                @onclick="@(() => HandlePageChange(pageNum))">
                            @pageNum
                        </button>
                    }

                    <Button IconName="chevron-right"
                            IconOnly="true"
                            Variant="Button.ButtonVariant.Ghost"
                            Size="Button.ButtonSize.Small"
                            Disabled="@(CurrentPage >= TotalPages)"
                            OnClick="@(() => HandlePageChange(CurrentPage + 1))"
                            title="Next page" />
                </div>
            </div>
        }
    }
</div>

@code {
    /// <summary>
    /// The list of mods to display from search results.
    /// </summary>
    [Parameter]
    public IReadOnlyList<ModSearchItem> Mods { get; set; } = [];

    /// <summary>
    /// Set of mod IDs that are already installed.
    /// </summary>
    [Parameter]
    public HashSet<string> InstalledModIds { get; set; } = [];

    /// <summary>
    /// Whether the data is currently loading.
    /// </summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>
    /// Set of mod IDs currently being operated on (installing, etc.).
    /// </summary>
    [Parameter]
    public HashSet<string> BusyMods { get; set; } = [];

    /// <summary>
    /// Total number of results across all pages.
    /// </summary>
    [Parameter]
    public int TotalCount { get; set; }

    /// <summary>
    /// Current page number (1-indexed).
    /// </summary>
    [Parameter]
    public int CurrentPage { get; set; } = 1;

    /// <summary>
    /// Number of items per page.
    /// </summary>
    [Parameter]
    public int PageSize { get; set; } = 20;

    /// <summary>
    /// Current sort column identifier.
    /// </summary>
    [Parameter]
    public string SortColumn { get; set; } = "downloads";

    /// <summary>
    /// Current sort direction (true = descending).
    /// </summary>
    [Parameter]
    public bool SortDescending { get; set; } = true;

    /// <summary>
    /// Callback when user clicks install on a mod.
    /// </summary>
    [Parameter]
    public EventCallback<ModSearchItem> OnInstall { get; set; }

    /// <summary>
    /// Callback when user clicks to view mod details.
    /// </summary>
    [Parameter]
    public EventCallback<ModSearchItem> OnViewDetails { get; set; }

    /// <summary>
    /// Callback when page changes.
    /// </summary>
    [Parameter]
    public EventCallback<int> OnPageChanged { get; set; }

    /// <summary>
    /// Callback when sort changes.
    /// </summary>
    [Parameter]
    public EventCallback<(string Column, bool Descending)> OnSortChanged { get; set; }

    // Computed properties
    private int TotalPages => PageSize > 0 ? (int)Math.Ceiling(TotalCount / (double)PageSize) : 1;
    private int StartIndex => TotalCount == 0 ? 0 : (CurrentPage - 1) * PageSize + 1;
    private int EndIndex => Math.Min(CurrentPage * PageSize, TotalCount);

    private async Task HandleInstall(ModSearchItem mod)
    {
        await OnInstall.InvokeAsync(mod);
    }

    private async Task HandleViewDetails(ModSearchItem mod)
    {
        await OnViewDetails.InvokeAsync(mod);
    }

    private async Task HandlePageChange(int page)
    {
        if (page >= 1 && page <= TotalPages && page != CurrentPage)
        {
            await OnPageChanged.InvokeAsync(page);
        }
    }

    private async Task HandleSort(string column)
    {
        var descending = SortColumn == column ? !SortDescending : false;
        await OnSortChanged.InvokeAsync((column, descending));
    }

    private string GetSortClass(string column)
    {
        if (SortColumn != column) return string.Empty;
        return SortDescending ? "sort-desc" : "sort-asc";
    }

    private string GetSortIcon(string column)
    {
        if (SortColumn != column) return "chevron-down";
        return SortDescending ? "chevron-down" : "chevron-up";
    }

    private string GetRowClasses(ModSearchItem mod)
    {
        var classes = new List<string> { "cursor-pointer", "hover:bg-nebula-bg-tertiary" };

        if (InstalledModIds.Contains(mod.Id))
            classes.Add("row-installed");

        if (BusyMods.Contains(mod.Id))
            classes.Add("row-busy");

        return string.Join(" ", classes);
    }

    private IEnumerable<int> GetPageNumbers()
    {
        const int maxVisible = 5;
        var total = TotalPages;

        if (total <= maxVisible)
        {
            return Enumerable.Range(1, total);
        }

        var half = maxVisible / 2;
        var start = Math.Max(1, CurrentPage - half);
        var end = Math.Min(total, start + maxVisible - 1);

        if (end - start + 1 < maxVisible)
        {
            start = Math.Max(1, end - maxVisible + 1);
        }

        return Enumerable.Range(start, end - start + 1);
    }

    private static string GetPrimaryCategory(List<string> categories)
    {
        if (categories == null || categories.Count == 0)
            return "Mod";

        // Return first category, capitalized
        var category = categories[0];
        return string.IsNullOrEmpty(category) ? "Mod" : char.ToUpper(category[0]) + category[1..].ToLower();
    }

    private static string GetCategoryBadgeClass(string category)
    {
        return category.ToLowerInvariant() switch
        {
            "plugin" => "classification-plugin",
            "mod" => "classification-mod",
            "mods" => "classification-mod",
            "data" => "classification-data",
            "datapack" => "classification-data",
            "art" => "classification-art",
            "resourcepack" => "classification-art",
            "texture" => "classification-art",
            "shader" => "classification-art",
            "save" => "classification-save",
            "world" => "classification-save",
            "map" => "classification-save",
            "modpack" => "classification-modpack",
            _ => "classification-mod"
        };
    }

    private static string GetClassificationIcon(string category)
    {
        return category.ToLowerInvariant() switch
        {
            "plugin" => "\ud83d\udd0c",
            "data" or "datapack" => "\ud83d\udcca",
            "art" or "resourcepack" or "texture" or "shader" => "\ud83c\udfa8",
            "save" or "world" or "map" => "\ud83d\uddfa\ufe0f",
            "modpack" => "\ud83d\udce6",
            _ => "\ud83d\udce6"
        };
    }

    private static string GetProviderDisplayName(ModProviderType provider) => provider switch
    {
        ModProviderType.CurseForge => "CurseForge",
        ModProviderType.Modrinth => "Modrinth",
        ModProviderType.Thunderstore => "Thunderstore",
        ModProviderType.SpigotMC => "SpigotMC",
        ModProviderType.Hangar => "Hangar",
        ModProviderType.NexusMods => "Nexus",
        ModProviderType.SteamWorkshop => "Steam",
        ModProviderType.Modtale => "Modtale",
        ModProviderType.Local => "Local",
        _ => provider.ToString()
    };

    private static string FormatDownloads(long downloads)
    {
        if (downloads >= 1_000_000_000)
            return $"{downloads / 1_000_000_000.0:F1}B";
        if (downloads >= 1_000_000)
            return $"{downloads / 1_000_000.0:F1}M";
        if (downloads >= 1_000)
            return $"{downloads / 1_000.0:F1}K";
        return downloads.ToString("N0");
    }

    private static string FormatRelativeDate(DateTime? date)
    {
        if (!date.HasValue) return "Unknown";

        var now = DateTime.UtcNow;
        var diff = now - date.Value.ToUniversalTime();

        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        if (diff.TotalDays < 30) return $"{(int)(diff.TotalDays / 7)}w ago";
        if (diff.TotalDays < 365) return $"{(int)(diff.TotalDays / 30)}mo ago";
        return $"{(int)(diff.TotalDays / 365)}y ago";
    }

    private static string TruncateSummary(string? summary, int maxLength)
    {
        if (string.IsNullOrEmpty(summary)) return string.Empty;
        if (summary.Length <= maxLength) return summary;
        return summary[..maxLength].TrimEnd() + "...";
    }
}

@inherits ComponentBase

<div class="@ContainerClasses">
    <button type="button"
            class="@ComputedClasses"
            role="switch"
            aria-checked="@Value.ToString().ToLower()"
            disabled="@Disabled"
            @onclick="HandleClick"
            @onkeydown="HandleKeyDown"
            @attributes="AdditionalAttributes">
        <span class="toggle-knob" aria-hidden="true"></span>
    </button>

    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="text-sm cursor-pointer select-none ml-3 @LabelClasses"
               @onclick="HandleClick">
            @Label
        </label>
    }
</div>

@code {
    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public ToggleSize Size { get; set; } = ToggleSize.Medium;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ContainerClasses => "inline-flex items-center";

    private string LabelClasses => Disabled
        ? "text-nebula-text-disabled cursor-not-allowed"
        : "text-nebula-text-secondary";

    private string ComputedClasses
    {
        get
        {
            var classes = new List<string> { "toggle", GetSizeClass() };

            if (!string.IsNullOrEmpty(Class))
                classes.Add(Class);

            return string.Join(" ", classes);
        }
    }

    private string GetSizeClass() => Size switch
    {
        ToggleSize.Small => "toggle-sm",
        ToggleSize.Medium => "",
        ToggleSize.Large => "toggle-lg",
        _ => ""
    };

    private async Task HandleClick()
    {
        if (!Disabled)
        {
            await ValueChanged.InvokeAsync(!Value);
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (!Disabled && (e.Key == " " || e.Key == "Enter"))
        {
            await ValueChanged.InvokeAsync(!Value);
        }
    }

    public enum ToggleSize
    {
        Small,
        Medium,
        Large
    }
}

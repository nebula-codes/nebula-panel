@using NebulaPanel.Domain.ValueObjects

<div class="form-group">
    <div class="flex items-center justify-between">
        <label for="@_id" class="label">
            @if (IsModified)
            {
                <span class="inline-block w-1.5 h-1.5 rounded-full bg-nebula-accent mr-1.5" title="Modified from default"></span>
            }
            @Field.DisplayName
            @if (Field.Required)
            {
                <span class="text-nebula-error ml-1">*</span>
            }
        </label>
        <div class="flex items-center gap-2">
            @if (IsModified && OnResetToDefault.HasDelegate)
            {
                <button type="button"
                        @onclick="OnResetToDefault"
                        class="text-xs text-nebula-text-muted hover:text-nebula-accent transition-colors"
                        title="Reset to default">
                    <Icon Name="rotate-ccw" Size="IconSize.Small" />
                </button>
            }
            @if (ShowValue)
            {
                <span class="text-sm font-medium text-nebula-text-primary">
                    @DisplayValue
                    @if (!string.IsNullOrEmpty(Field.Unit))
                    {
                        <span class="text-nebula-text-muted">@Field.Unit</span>
                    }
                </span>
            }
        </div>
    </div>

    <div class="flex items-center gap-3">
        @if (ShowLabels)
        {
            <span class="text-xs text-nebula-text-muted w-10 text-right">@Min</span>
        }

        <input type="range"
               id="@_id"
               value="@Value"
               @oninput="OnInput"
               disabled="@(Disabled || Field.ReadOnly)"
               min="@Min"
               max="@Max"
               step="@Step"
               class="slider flex-1" />

        @if (ShowLabels)
        {
            <span class="text-xs text-nebula-text-muted w-10">@Max</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(Field.Description) && !HasErrors)
    {
        <p class="text-xs text-nebula-text-muted mt-1">@Field.Description</p>
    }

    @if (HasErrors)
    {
        <p class="text-xs text-nebula-error mt-1">@string.Join(", ", Errors!)</p>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ConfigField Field { get; set; } = null!;

    [Parameter]
    public double Value { get; set; }

    [Parameter]
    public EventCallback<double> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public List<string>? Errors { get; set; }

    [Parameter]
    public bool IsModified { get; set; }

    [Parameter]
    public EventCallback OnResetToDefault { get; set; }

    private string _id = Guid.NewGuid().ToString("N")[..8];
    private bool HasErrors => Errors?.Count > 0;

    private double Min => Field.SliderOptions?.Min ?? Field.Validation?.MinValueDouble ?? Field.Validation?.MinValue ?? 0;
    private double Max => Field.SliderOptions?.Max ?? Field.Validation?.MaxValueDouble ?? Field.Validation?.MaxValue ?? 100;
    private double Step => Field.SliderOptions?.Step ?? 1;
    private bool ShowLabels => Field.SliderOptions?.ShowLabels ?? true;
    private bool ShowValue => Field.SliderOptions?.ShowValue ?? true;

    private string DisplayValue => Step >= 1 ? ((int)Value).ToString() : Value.ToString("F1");

    private async Task OnInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var value))
        {
            await ValueChanged.InvokeAsync(value);
        }
    }
}

@using NebulaPanel.Domain.ValueObjects

<div class="border border-nebula-border-subtle rounded-lg overflow-hidden mb-4">
    <button type="button"
            class="w-full flex items-center justify-between p-4 bg-nebula-surface-secondary hover:bg-nebula-surface-tertiary transition-colors text-left"
            @onclick="ToggleExpanded">
        <div class="flex items-center gap-3">
            @if (!string.IsNullOrEmpty(Section?.Icon))
            {
                <Icon Name="@Section.Icon" Size="IconSize.Medium" Class="text-nebula-text-muted" />
            }
            <div>
                <h3 class="font-medium text-nebula-text-primary">@Title</h3>
                @if (!string.IsNullOrEmpty(Description))
                {
                    <p class="text-sm text-nebula-text-muted">@Description</p>
                }
            </div>
        </div>

        <div class="flex items-center gap-2">
            @if (ModifiedCount > 0)
            {
                <span class="inline-flex items-center justify-center px-2 py-1 text-xs font-medium rounded-full bg-nebula-accent/20 text-nebula-accent">
                    @ModifiedCount modified
                </span>
            }
            @if (ErrorCount > 0)
            {
                <span class="inline-flex items-center justify-center px-2 py-1 text-xs font-medium rounded-full bg-nebula-error/20 text-nebula-error">
                    @ErrorCount @(ErrorCount == 1 ? "error" : "errors")
                </span>
            }
            <Icon Name="@(_expanded ? "chevron-up" : "chevron-down")"
                  Size="IconSize.Small"
                  Class="text-nebula-text-muted transition-transform duration-200" />
        </div>
    </button>

    @if (_expanded)
    {
        <div class="p-4 bg-nebula-surface-primary border-t border-nebula-border-subtle">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter]
    public ConfigSection? Section { get; set; }

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool DefaultExpanded { get; set; } = true;

    [Parameter]
    public int ErrorCount { get; set; }

    [Parameter]
    public int ModifiedCount { get; set; }

    private bool _expanded;

    protected override void OnInitialized()
    {
        _expanded = Section?.DefaultExpanded ?? DefaultExpanded;
    }

    private void ToggleExpanded()
    {
        _expanded = !_expanded;
    }
}

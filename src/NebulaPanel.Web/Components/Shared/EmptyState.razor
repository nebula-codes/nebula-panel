@* Reusable empty state component with cosmic styling *@

<div class="@ComputedClasses">
    <div class="empty-state-icon">
        <Icon Name="@IconName" Size="Icon.IconSize.XLarge" Class="text-nebula-text-muted" />
    </div>

    <h3 class="text-lg font-semibold text-nebula-text-primary mb-2">@Heading</h3>

    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="text-sm text-nebula-text-muted max-w-sm mb-4">@Description</p>
    }

    @if (Actions is not null)
    {
        <div class="mt-2">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter]
    public string IconName { get; set; } = "inbox";

    [Parameter, EditorRequired]
    public string Heading { get; set; } = "No items found";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public bool ShowStarfield { get; set; } = false;

    [Parameter]
    public string? Class { get; set; }

    private string ComputedClasses
    {
        get
        {
            var classes = new List<string>
            {
                "empty-state",
                "rounded-nebula-lg"
            };

            if (ShowStarfield)
            {
                classes.Add("empty-state-starfield");
            }

            if (!string.IsNullOrEmpty(Class))
            {
                classes.Add(Class);
            }

            return string.Join(" ", classes);
        }
    }
}

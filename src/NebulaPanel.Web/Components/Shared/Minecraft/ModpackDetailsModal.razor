@using NebulaPanel.Application.DTOs
@using NebulaPanel.Application.Services
@using NebulaPanel.Domain.Enums
@using NebulaPanel.Domain.Interfaces
@inject IUnifiedModpackService ModpackService

<Modal IsOpen="@IsOpen"
       Size="ModalSize.XLarge"
       OnClose="HandleClose"
       ShowCloseButton="true"
       CloseOnBackdropClick="true"
       CloseOnEscape="true">
    <Header>
        <span class="text-lg font-medium text-nebula-text-primary">Modpack Details</span>
    </Header>
    <Body>
        @if (_isLoading)
        {
            <div class="flex items-center justify-center py-12">
                <div class="flex flex-col items-center gap-3">
                    <div class="animate-spin rounded-full h-8 w-8 border-2 border-nebula-accent border-t-transparent"></div>
                    <span class="text-nebula-text-muted">Loading modpack details...</span>
                </div>
            </div>
        }
        else if (_error != null)
        {
            <div class="bg-nebula-error/10 border border-nebula-error text-nebula-error rounded-nebula p-4">
                <div class="flex items-center gap-2">
                    <Icon Name="alert-circle" Size="IconSize.Small" />
                    <span>@_error</span>
                </div>
            </div>
        }
        else if (_details != null)
        {
            <div class="modpack-details-content">
                @* Header Section *@
                <div class="flex gap-4 mb-6">
                    @* Icon *@
                    <div class="modpack-detail-icon">
                        @if (!string.IsNullOrEmpty(_details.IconUrl))
                        {
                            <img src="@_details.IconUrl" alt="@_details.Name" class="w-full h-full object-cover rounded-lg" />
                        }
                        else
                        {
                            <Icon Name="package" Size="IconSize.XLarge" Class="text-nebula-text-muted" />
                        }
                    </div>

                    @* Info *@
                    <div class="flex-1">
                        <h2 class="text-xl font-semibold text-nebula-text-primary mb-1">@_details.Name</h2>

                        <div class="flex flex-wrap items-center gap-2 text-sm text-nebula-text-secondary mb-3">
                            @if (_details.Authors.Count > 0)
                            {
                                <span>by @string.Join(", ", _details.Authors.Select(a => a.Name))</span>
                                <span class="text-nebula-text-muted">•</span>
                            }
                            @if (_details.Loaders.Count > 0)
                            {
                                <StatusBadge Status="@GetLoaderStatus(_details.Loaders[0])" Size="BadgeSize.Small">
                                    @GetLoaderName(_details.Loaders[0])
                                </StatusBadge>
                            }
                            @if (_details.MinecraftVersions.Count > 0)
                            {
                                <span>@_details.MinecraftVersions[0]</span>
                            }
                        </div>

                        @* Stats *@
                        <div class="flex flex-wrap items-center gap-4 text-sm text-nebula-text-muted">
                            <span class="flex items-center gap-1">
                                <Icon Name="download" Size="IconSize.Small" />
                                @FormatDownloads(_details.Downloads) downloads
                            </span>
                            <span class="flex items-center gap-1">
                                <Icon Name="calendar" Size="IconSize.Small" />
                                Updated @FormatDate(_details.UpdatedAt)
                            </span>
                            @if (_details.ModCount > 0)
                            {
                                <span class="flex items-center gap-1">
                                    <Icon Name="puzzle" Size="IconSize.Small" />
                                    @_details.ModCount mods
                                </span>
                            }
                        </div>

                        @* External Links *@
                        @if (_details.Links.Count > 0)
                        {
                            <div class="flex flex-wrap items-center gap-2 mt-3">
                                @foreach (var link in _details.Links.Take(4))
                                {
                                    <a href="@link.Url" target="_blank" rel="noopener noreferrer"
                                       class="inline-flex items-center gap-1 text-xs px-2 py-1 rounded bg-nebula-bg-tertiary text-nebula-text-secondary hover:text-nebula-accent transition-colors">
                                        <Icon Name="@GetLinkIcon(link.Type)" Size="IconSize.XSmall" />
                                        @(link.Name ?? link.Type)
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* Tabs *@
                <div class="border-b border-nebula-border-subtle mb-4">
                    <div class="flex gap-4">
                        <button type="button"
                                class="tab-button @(_activeTab == "description" ? "active" : "")"
                                @onclick="SetDescriptionTab">
                            Description
                        </button>
                        @if (_details.Screenshots.Count > 0)
                        {
                            <button type="button"
                                    class="tab-button @(_activeTab == "screenshots" ? "active" : "")"
                                    @onclick="SetScreenshotsTab">
                                Screenshots (@_details.Screenshots.Count)
                            </button>
                        }
                    </div>
                </div>

                @* Tab Content *@
                <div class="tab-content mb-6">
                    @if (_activeTab == "description")
                    {
                        <div class="prose prose-invert max-w-none text-sm text-nebula-text-secondary max-h-48 overflow-y-auto">
                            @if (!string.IsNullOrEmpty(_details.Description))
                            {
                                @((MarkupString)SanitizeHtml(_details.Description))
                            }
                            else if (!string.IsNullOrEmpty(_details.Summary))
                            {
                                <p>@_details.Summary</p>
                            }
                            else
                            {
                                <p class="text-nebula-text-muted italic">No description available.</p>
                            }
                        </div>
                    }
                    else if (_activeTab == "screenshots" && _details.Screenshots.Count > 0)
                    {
                        <div class="screenshot-grid">
                            @foreach (var screenshot in _details.Screenshots)
                            {
                                <a href="@screenshot.Url" target="_blank" rel="noopener noreferrer"
                                   class="screenshot-item">
                                    <img src="@screenshot.Url" alt="@(screenshot.Title ?? "Screenshot")"
                                         class="w-full h-full object-cover" />
                                </a>
                            }
                        </div>
                    }
                </div>

                @* Version Selection *@
                <div class="mb-4">
                    <h3 class="text-sm font-medium text-nebula-text-primary mb-3">Select Version</h3>

                    @if (_isLoadingVersions)
                    {
                        <div class="flex items-center gap-2 text-nebula-text-muted py-4">
                            <div class="animate-spin rounded-full h-4 w-4 border-2 border-nebula-accent border-t-transparent"></div>
                            <span class="text-sm">Loading versions...</span>
                        </div>
                    }
                    else if (_versions.Count > 0)
                    {
                        <div class="version-list">
                            @foreach (var version in _versions.Take(10))
                            {
                                <label class="version-item @(_selectedVersionId == version.Id ? "selected" : "")">
                                    <input type="radio"
                                           name="modpack-version"
                                           value="@version.Id"
                                           checked="@(_selectedVersionId == version.Id)"
                                           @onchange="() => SelectVersion(version)" />
                                    <div class="flex-1">
                                        <div class="flex items-center gap-2">
                                            <span class="font-medium text-nebula-text-primary">@version.Name</span>
                                            @if (version == _versions.First())
                                            {
                                                <span class="badge badge-success text-xs">Latest</span>
                                            }
                                            @if (version.Type != ModpackVersionType.Release)
                                            {
                                                <span class="badge @(version.Type == ModpackVersionType.Beta ? "badge-warning" : "badge-neutral") text-xs">
                                                    @version.Type
                                                </span>
                                            }
                                        </div>
                                        <div class="flex items-center gap-3 text-xs text-nebula-text-muted mt-1">
                                            <span>@version.MinecraftVersion</span>
                                            <span>@GetLoaderName(version.Loader)</span>
                                            <span>@FormatDate(version.ReleasedAt)</span>
                                            @if (version.ServerPackSize.HasValue)
                                            {
                                                <span>@FormatBytes(version.ServerPackSize.Value)</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="flex items-center">
                                        @if (version.HasServerPack)
                                        {
                                            <span class="flex items-center gap-1 text-xs text-nebula-success">
                                                <Icon Name="check-circle" Size="IconSize.XSmall" />
                                                Server
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="flex items-center gap-1 text-xs text-nebula-warning">
                                                <Icon Name="alert-triangle" Size="IconSize.XSmall" />
                                                No Server
                                            </span>
                                        }
                                    </div>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-sm text-nebula-text-muted">No versions available.</p>
                    }
                </div>

                @* No Server Pack Warning *@
                @if (_selectedVersion != null && !_selectedVersion.HasServerPack)
                {
                    <div class="bg-nebula-warning/10 border border-nebula-warning text-nebula-warning rounded-nebula p-3 mb-4">
                        <div class="flex items-start gap-2">
                            <Icon Name="alert-triangle" Size="IconSize.Small" Class="mt-0.5" />
                            <div>
                                <p class="font-medium text-sm">No server pack available</p>
                                <p class="text-xs mt-1 opacity-80">
                                    This version doesn't include dedicated server files. The installer will download the full pack
                                    and automatically filter out client-only mods (like shaders and OptiFine).
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </Body>
    <Footer>
        <div class="flex justify-end gap-3">
            <Button Variant="ButtonVariant.Secondary" Text="Cancel" OnClick="HandleClose" />
            <Button Variant="ButtonVariant.Primary"
                    Text="Install This Modpack"
                    IconName="download"
                    Disabled="@(_selectedVersion == null)"
                    OnClick="HandleInstall" />
        </div>
    </Footer>
</Modal>

@code {
    /// <summary>
    /// The modpack ID to display.
    /// </summary>
    [Parameter]
    public string? ModpackId { get; set; }

    /// <summary>
    /// The provider the modpack is from.
    /// </summary>
    [Parameter]
    public ModpackProviderType Provider { get; set; }

    /// <summary>
    /// Whether the modal is open.
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Callback when the modal is closed.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Callback when the user clicks Install.
    /// </summary>
    [Parameter]
    public EventCallback<ModpackInstallRequest> OnInstall { get; set; }

    // State
    private ModpackDetails? _details;
    private List<ModpackVersion> _versions = [];
    private string? _selectedVersionId;
    private ModpackVersion? _selectedVersion;
    private string _activeTab = "description";
    private bool _isLoading;
    private bool _isLoadingVersions;
    private string? _error;
    private string? _lastLoadedModpackId;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && ModpackId != null && ModpackId != _lastLoadedModpackId)
        {
            await LoadModpackAsync();
        }
    }

    private async Task LoadModpackAsync()
    {
        if (string.IsNullOrEmpty(ModpackId)) return;

        _isLoading = true;
        _isLoadingVersions = true;
        _error = null;
        _details = null;
        _versions = [];
        _selectedVersion = null;
        _selectedVersionId = null;
        _activeTab = "description";
        _lastLoadedModpackId = ModpackId;
        StateHasChanged();

        try
        {
            // Load details and versions in parallel
            var detailsTask = ModpackService.GetDetailsAsync(Provider, ModpackId);
            var versionsTask = ModpackService.GetVersionsAsync(Provider, ModpackId);

            _details = await detailsTask;
            _isLoading = false;
            StateHasChanged();

            _versions = (await versionsTask).ToList();
            _isLoadingVersions = false;

            // Auto-select the latest version with server pack, or just the latest
            var preferredVersion = _versions.FirstOrDefault(v => v.HasServerPack) ?? _versions.FirstOrDefault();
            if (preferredVersion != null)
            {
                SelectVersion(preferredVersion);
            }
        }
        catch (Exception ex)
        {
            _error = $"Failed to load modpack details: {ex.Message}";
            _isLoading = false;
            _isLoadingVersions = false;
        }

        StateHasChanged();
    }

    private void SelectVersion(ModpackVersion version)
    {
        _selectedVersion = version;
        _selectedVersionId = version.Id;
    }

    private void SetDescriptionTab() => _activeTab = "description";
    private void SetScreenshotsTab() => _activeTab = "screenshots";

    private async Task HandleClose()
    {
        _lastLoadedModpackId = null;
        await OnClose.InvokeAsync();
    }

    private async Task HandleInstall()
    {
        if (_selectedVersion == null || _details == null) return;

        var request = new ModpackInstallRequest
        {
            Provider = Provider,
            ModpackId = ModpackId!,
            VersionId = _selectedVersion.Id,
            ModpackName = _details.Name,
            VersionName = _selectedVersion.Name,
            MinecraftVersion = _selectedVersion.MinecraftVersion,
            Loader = _selectedVersion.Loader,
            LoaderVersion = _selectedVersion.LoaderVersion,
            ModCount = _details.ModCount
        };

        await OnInstall.InvokeAsync(request);
    }

    private static string FormatDownloads(long count) => count switch
    {
        >= 1_000_000 => $"{count / 1_000_000.0:F1}M",
        >= 1_000 => $"{count / 1_000.0:F1}K",
        _ => count.ToString()
    };

    private static string FormatDate(DateTime date)
    {
        var diff = DateTime.UtcNow - date;
        var days = diff.TotalDays;
        if (days < 1) return "today";
        if (days < 2) return "yesterday";
        if (days < 7) return $"{(int)days} days ago";
        if (days < 30) return $"{(int)(days / 7)} weeks ago";
        if (days < 365) return $"{(int)(days / 30)} months ago";
        return date.ToString("MMM yyyy");
    }

    private static string FormatBytes(long bytes) => bytes switch
    {
        >= 1_073_741_824 => $"{bytes / 1_073_741_824.0:F1} GB",
        >= 1_048_576 => $"{bytes / 1_048_576.0:F1} MB",
        >= 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes} B"
    };

    private static string GetLoaderName(ModLoaderType loader) => loader switch
    {
        ModLoaderType.Forge => "Forge",
        ModLoaderType.NeoForge => "NeoForge",
        ModLoaderType.Fabric => "Fabric",
        ModLoaderType.Quilt => "Quilt",
        _ => "Unknown"
    };

    private static StatusBadge.StatusType GetLoaderStatus(ModLoaderType loader) => loader switch
    {
        ModLoaderType.Forge => StatusBadge.StatusType.Warning,
        ModLoaderType.NeoForge => StatusBadge.StatusType.Warning,
        ModLoaderType.Fabric => StatusBadge.StatusType.Info,
        ModLoaderType.Quilt => StatusBadge.StatusType.Info,
        _ => StatusBadge.StatusType.Neutral
    };

    private static string GetLinkIcon(string linkType) => linkType.ToLowerInvariant() switch
    {
        "discord" => "message-circle",
        "wiki" => "book-open",
        "github" or "source" => "github",
        "website" or "homepage" => "globe",
        "issues" => "alert-circle",
        "donation" or "donate" => "heart",
        _ => "external-link"
    };

    private static string SanitizeHtml(string html)
    {
        // Basic HTML sanitization - in production, use a proper sanitizer
        // For now, just allow basic formatting tags
        return html;
    }
}

@using NebulaPanel.Application.DTOs
@using NebulaPanel.Application.Services
@using NebulaPanel.Domain.Enums
@using NebulaPanel.Domain.Interfaces

<Modal IsOpen="@IsOpen"
       Size="ModalSize.Large"
       OnClose="HandleClose"
       ShowCloseButton="true"
       CloseOnBackdropClick="true"
       CloseOnEscape="true">
    <Header>
        <span class="text-lg font-medium text-nebula-text-primary">Mod Details</span>
    </Header>
    <Body>
        @if (Mod == null)
        {
            <div class="flex items-center justify-center py-12">
                <span class="text-nebula-text-muted">No mod selected</span>
            </div>
        }
        else if (_isLoading)
        {
            <div class="flex items-center justify-center py-12">
                <div class="flex flex-col items-center gap-3">
                    <div class="animate-spin rounded-full h-8 w-8 border-2 border-nebula-accent border-t-transparent"></div>
                    <span class="text-nebula-text-muted">Loading mod details...</span>
                </div>
            </div>
        }
        else if (_error != null)
        {
            <div class="bg-nebula-error/10 border border-nebula-error text-nebula-error rounded-nebula p-4">
                <div class="flex items-center gap-2">
                    <Icon Name="alert-circle" Size="IconSize.Small" />
                    <span>@_error</span>
                </div>
            </div>
        }
        else
        {
            <div class="mod-details-content">
                @* Header Section *@
                <div class="flex gap-4 mb-6">
                    @* Icon *@
                    <div class="w-20 h-20 flex-shrink-0">
                        @if (!string.IsNullOrEmpty(Mod.IconUrl))
                        {
                            <img src="@Mod.IconUrl" alt="@Mod.Name" class="w-full h-full object-cover rounded-lg" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center bg-nebula-bg-tertiary rounded-lg">
                                <Icon Name="package" Size="IconSize.XLarge" Class="text-nebula-text-muted" />
                            </div>
                        }
                    </div>

                    @* Info *@
                    <div class="flex-1 min-w-0">
                        <h2 class="text-xl font-semibold text-nebula-text-primary mb-1">@Mod.Name</h2>

                        <div class="flex flex-wrap items-center gap-2 text-sm text-nebula-text-secondary mb-3">
                            @if (!string.IsNullOrEmpty(Mod.Author))
                            {
                                <span>by @Mod.Author</span>
                                <span class="text-nebula-text-muted">•</span>
                            }
                            <span class="px-2 py-0.5 rounded-full text-xs font-medium @GetProviderBadgeClass(Mod.Provider)">
                                @GetProviderDisplayName(Mod.Provider)
                            </span>
                        </div>

                        @* Stats *@
                        <div class="flex flex-wrap items-center gap-4 text-sm text-nebula-text-muted">
                            <span class="flex items-center gap-1">
                                <Icon Name="download" Size="IconSize.Small" />
                                @FormatNumber(Mod.Downloads) downloads
                            </span>
                            @if (Mod.UpdatedAt.HasValue)
                            {
                                <span class="flex items-center gap-1" title="@Mod.UpdatedAt.Value.ToString("F")">
                                    <Icon Name="clock" Size="IconSize.Small" />
                                    Updated @FormatRelativeDate(Mod.UpdatedAt.Value)
                                </span>
                            }
                        </div>
                    </div>
                </div>

                @* Tabs *@
                <div class="border-b border-nebula-border-subtle mb-4">
                    <div class="flex gap-4">
                        <button type="button"
                                class="tab-button @(_activeTab == "description" ? "active" : "")"
                                @onclick="@(() => _activeTab = "description")">
                            Description
                        </button>
                        @if (_details?.Screenshots.Count > 0)
                        {
                            <button type="button"
                                    class="tab-button @(_activeTab == "screenshots" ? "active" : "")"
                                    @onclick="@(() => _activeTab = "screenshots")">
                                Screenshots (@_details.Screenshots.Count)
                            </button>
                        }
                        <button type="button"
                                class="tab-button @(_activeTab == "info" ? "active" : "")"
                                @onclick="@(() => _activeTab = "info")">
                            Info
                        </button>
                    </div>
                </div>

                @* Tab Content *@
                <div class="tab-content">
                    @if (_activeTab == "description")
                    {
                        <div class="prose prose-invert max-w-none text-sm text-nebula-text-secondary max-h-64 overflow-y-auto">
                            @if (_details != null && !string.IsNullOrEmpty(_details.Description))
                            {
                                @((MarkupString)SanitizeHtml(_details.Description))
                            }
                            else if (_details != null && !string.IsNullOrEmpty(_details.Summary))
                            {
                                <p>@_details.Summary</p>
                            }
                            else if (!string.IsNullOrEmpty(Mod.Summary))
                            {
                                <p>@Mod.Summary</p>
                            }
                            else
                            {
                                <p class="text-nebula-text-muted italic">No description available.</p>
                            }
                        </div>
                    }
                    else if (_activeTab == "screenshots" && _details?.Screenshots.Count > 0)
                    {
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 max-h-64 overflow-y-auto">
                            @foreach (var screenshot in _details.Screenshots)
                            {
                                <a href="@screenshot.Url" target="_blank" rel="noopener noreferrer"
                                   class="aspect-video rounded-lg overflow-hidden hover:ring-2 hover:ring-nebula-accent transition-all">
                                    <img src="@screenshot.Url" alt="@(screenshot.Title ?? "Screenshot")"
                                         class="w-full h-full object-cover" loading="lazy" />
                                </a>
                            }
                        </div>
                    }
                    else if (_activeTab == "info")
                    {
                        <div class="grid grid-cols-2 gap-4 text-sm">
                            <div>
                                <span class="text-nebula-text-muted block mb-1">Mod ID</span>
                                <span class="text-nebula-text-primary font-mono text-xs">@Mod.Id</span>
                            </div>
                            <div>
                                <span class="text-nebula-text-muted block mb-1">Provider</span>
                                <span class="text-nebula-text-primary">@GetProviderDisplayName(Mod.Provider)</span>
                            </div>
                            @if (_details?.GameVersions.Count > 0)
                            {
                                <div class="col-span-2">
                                    <span class="text-nebula-text-muted block mb-1">Game Versions</span>
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var version in _details.GameVersions.Take(10))
                                        {
                                            <span class="px-2 py-0.5 rounded bg-nebula-bg-tertiary text-xs text-nebula-text-secondary">
                                                @version
                                            </span>
                                        }
                                        @if (_details.GameVersions.Count > 10)
                                        {
                                            <span class="px-2 py-0.5 rounded bg-nebula-bg-tertiary text-xs text-nebula-text-muted">
                                                +@(_details.GameVersions.Count - 10) more
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (Mod.Categories.Count > 0)
                            {
                                <div class="col-span-2">
                                    <span class="text-nebula-text-muted block mb-1">Categories</span>
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var category in Mod.Categories)
                                        {
                                            <span class="px-2 py-0.5 rounded-full bg-nebula-accent/20 text-xs text-nebula-accent">
                                                @category
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (_details?.SourceUrl != null)
                            {
                                <div>
                                    <span class="text-nebula-text-muted block mb-1">Source</span>
                                    <a href="@_details.SourceUrl" target="_blank" rel="noopener noreferrer"
                                       class="text-nebula-accent hover:underline text-xs">
                                        View Source
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </Body>
    <Footer>
        <div class="flex justify-end gap-3">
            <Button Variant="ButtonVariant.Secondary" Text="Close" OnClick="HandleClose" />
            <Button Variant="ButtonVariant.Primary"
                    Text="Install"
                    IconName="download"
                    Disabled="@(Mod == null)"
                    OnClick="HandleInstall" />
        </div>
    </Footer>
</Modal>

@code {
    /// <summary>
    /// The mod to display details for.
    /// </summary>
    [Parameter]
    public ModSearchItem? Mod { get; set; }

    /// <summary>
    /// Whether the modal is open.
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Callback when the modal is closed.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Callback when user clicks Install.
    /// </summary>
    [Parameter]
    public EventCallback<ModSearchItem> OnInstall { get; set; }

    [Inject]
    private IHytaleModService ModService { get; set; } = default!;

    // State
    private ModDetails? _details;
    private bool _isLoading;
    private string? _error;
    private string _activeTab = "description";
    private string? _lastLoadedModId;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Mod != null && Mod.Id != _lastLoadedModId)
        {
            await LoadDetailsAsync();
        }
    }

    private async Task LoadDetailsAsync()
    {
        if (Mod == null) return;

        _isLoading = true;
        _error = null;
        _details = null;
        _activeTab = "description";
        _lastLoadedModId = Mod.Id;
        StateHasChanged();

        try
        {
            _details = await ModService.GetDetailsAsync(Mod.Provider, Mod.Id);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load mod details: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleClose()
    {
        _lastLoadedModId = null;
        await OnClose.InvokeAsync();
    }

    private async Task HandleInstall()
    {
        if (Mod != null)
        {
            await OnInstall.InvokeAsync(Mod);
        }
    }

    private static string GetProviderDisplayName(ModProviderType provider) => provider switch
    {
        ModProviderType.Modtale => "Modtale",
        ModProviderType.CurseForge => "CurseForge",
        ModProviderType.Modrinth => "Modrinth",
        ModProviderType.Local => "Local",
        _ => provider.ToString()
    };

    private static string GetProviderBadgeClass(ModProviderType provider) => provider switch
    {
        ModProviderType.Modtale => "bg-blue-500/20 text-blue-400",
        ModProviderType.CurseForge => "bg-orange-500/20 text-orange-400",
        ModProviderType.Modrinth => "bg-green-500/20 text-green-400",
        _ => "bg-nebula-bg-tertiary text-nebula-text-muted"
    };

    private static string FormatNumber(long number) => number switch
    {
        >= 1_000_000 => $"{number / 1_000_000.0:0.#}M",
        >= 1_000 => $"{number / 1_000.0:0.#}K",
        _ => number.ToString("N0")
    };

    private static string FormatRelativeDate(DateTime date)
    {
        var now = DateTime.UtcNow;
        var diff = now - date.ToUniversalTime();

        if (diff.TotalSeconds < 60) return "just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        if (diff.TotalDays < 30) return $"{(int)(diff.TotalDays / 7)}w ago";
        if (diff.TotalDays < 365) return $"{(int)(diff.TotalDays / 30)}mo ago";
        return $"{(int)(diff.TotalDays / 365)}y ago";
    }

    private static string SanitizeHtml(string html)
    {
        // Basic HTML sanitization - in production, use a proper sanitizer
        return html;
    }
}

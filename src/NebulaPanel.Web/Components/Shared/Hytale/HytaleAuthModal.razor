@using System.Security.Claims
@using NebulaPanel.Application.Services
@using NebulaPanel.Domain.Entities
@using NebulaPanel.Domain.Interfaces
@inject IHytaleAuthService AuthService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@implements IDisposable

<Modal @bind-IsOpen="IsOpen" Title="@ModalTitle" Size="Modal.ModalSize.Medium" CloseOnBackdropClick="false">
    <Body>
        @switch (_state)
        {
            case AuthState.Initial:
            case AuthState.Starting:
                <div class="text-center py-6">
                    <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-nebula-accent mx-auto"></div>
                    <p class="text-nebula-text-primary font-medium mt-4">@_startupStatusMessage</p>
                    <p class="text-nebula-text-muted text-sm mt-2">This may take up to 60 seconds...</p>
                    @if (_startupElapsedSeconds > 0)
                    {
                        <div class="mt-4 w-full max-w-xs mx-auto">
                            <div class="h-1 bg-nebula-bg-tertiary rounded-full overflow-hidden">
                                <div class="h-full bg-nebula-accent/50 transition-all duration-1000"
                                     style="width: @(Math.Min(_startupElapsedSeconds * 2, 90))%"></div>
                            </div>
                            <p class="text-nebula-text-disabled text-xs mt-1">@_startupElapsedSeconds seconds</p>
                        </div>
                    }
                </div>
                break;

            case AuthState.WaitingForUser:
                <div class="space-y-6">
                    @* Step 1: Verification URL *@
                    <div class="auth-step">
                        <div class="step-number">1</div>
                        <div class="flex-1">
                            <h3 class="font-medium text-nebula-text-primary mb-2">Open the authorization page</h3>
                            <div class="flex items-center gap-2">
                                <div class="flex-1 bg-nebula-bg-tertiary rounded-nebula px-3 py-2 font-mono text-sm text-nebula-text-secondary truncate">
                                    @_deviceCode?.VerificationUrl
                                </div>
                                <button class="btn btn-secondary btn-sm" @onclick="CopyUrl" title="Copy URL">
                                    <Icon Name="@(_copiedUrl ? "check" : "copy")" Size="Icon.IconSize.Small" />
                                </button>
                            </div>
                            <button class="btn btn-primary w-full mt-3" @onclick="OpenUrl">
                                <Icon Name="external-link" Size="Icon.IconSize.Small" Class="mr-2" />
                                Open in Browser
                            </button>
                        </div>
                    </div>

                    @* Step 2: Device Code *@
                    <div class="auth-step">
                        <div class="step-number">2</div>
                        <div class="flex-1">
                            <h3 class="font-medium text-nebula-text-primary mb-2">Enter this code</h3>
                            <div class="device-code-display">
                                @_deviceCode?.UserCode
                            </div>
                            <button class="btn btn-secondary w-full mt-3" @onclick="CopyCode">
                                <Icon Name="@(_copiedCode ? "check" : "copy")" Size="Icon.IconSize.Small" Class="mr-2" />
                                @(_copiedCode ? "Copied!" : "Copy Code")
                            </button>
                        </div>
                    </div>

                    @* Waiting indicator *@
                    <div class="border-t border-nebula-border pt-4">
                        <div class="flex items-center gap-3 text-nebula-text-muted">
                            <div class="animate-spin rounded-full h-4 w-4 border-b-2 border-nebula-accent"></div>
                            <span>Waiting for authorization...</span>
                        </div>

                        @* Progress bar *@
                        <div class="mt-3 h-1.5 bg-nebula-bg-tertiary rounded-full overflow-hidden">
                            <div class="h-full bg-nebula-accent transition-all duration-1000 ease-linear"
                                 style="width: @(100 - _progressPercent)%"></div>
                        </div>

                        @* Countdown timer *@
                        <div class="@CountdownClass mt-2 text-sm">
                            Code expires in: @FormatTimeRemaining()
                        </div>
                    </div>
                </div>
                break;

            case AuthState.Success:
                <div class="text-center py-6">
                    <div class="w-16 h-16 rounded-full bg-nebula-success/20 flex items-center justify-center mx-auto mb-4">
                        <Icon Name="check-circle" Size="Icon.IconSize.XLarge" Class="text-nebula-success" />
                    </div>
                    <h3 class="text-xl font-semibold text-nebula-text-primary mb-2">Connected Successfully!</h3>
                    <p class="text-nebula-text-muted mb-4">Your Hytale account has been connected.</p>

                    @if (_credentials != null)
                    {
                        <div class="bg-nebula-bg-tertiary rounded-nebula p-4 text-left space-y-2">
                            @if (!string.IsNullOrEmpty(_credentials.HytaleUsername))
                            {
                                <div class="flex justify-between">
                                    <span class="text-nebula-text-muted">Account:</span>
                                    <span class="text-nebula-text-primary font-medium">@_credentials.HytaleUsername</span>
                                </div>
                            }
                            <div class="flex justify-between">
                                <span class="text-nebula-text-muted">Token valid for:</span>
                                <span class="text-nebula-text-primary font-medium">@FormatTokenValidity()</span>
                            </div>
                        </div>
                    }
                </div>
                break;

            case AuthState.Expired:
                <div class="text-center py-6">
                    <div class="w-16 h-16 rounded-full bg-nebula-warning/20 flex items-center justify-center mx-auto mb-4">
                        <Icon Name="clock" Size="Icon.IconSize.XLarge" Class="text-nebula-warning" />
                    </div>
                    <h3 class="text-xl font-semibold text-nebula-text-primary mb-2">Code Expired</h3>
                    <p class="text-nebula-text-muted mb-4">The authorization code has expired. Please try again.</p>
                </div>
                break;

            case AuthState.Failed:
                <div class="text-center py-6">
                    <div class="w-16 h-16 rounded-full bg-nebula-error/20 flex items-center justify-center mx-auto mb-4">
                        <Icon Name="x-circle" Size="Icon.IconSize.XLarge" Class="text-nebula-error" />
                    </div>
                    <h3 class="text-xl font-semibold text-nebula-text-primary mb-2">Authentication Failed</h3>
                    <p class="text-nebula-text-muted mb-4">@_errorMessage</p>
                </div>
                break;
        }
    </Body>
    <Footer>
        @switch (_state)
        {
            case AuthState.WaitingForUser:
                <Button Variant="ButtonVariant.Secondary" Text="Cancel" OnClick="Cancel" />
                break;

            case AuthState.Success:
                <Button Variant="ButtonVariant.Primary" Text="Continue to Server Setup" OnClick="ContinueAfterSuccess" />
                break;

            case AuthState.Expired:
            case AuthState.Failed:
                <Button Variant="ButtonVariant.Secondary" Text="Cancel" OnClick="Cancel" />
                <Button Variant="ButtonVariant.Primary" Text="Try Again" OnClick="StartAuthentication" />
                break;
        }
    </Footer>
</Modal>

@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public EventCallback<HytaleUserCredentials> OnAuthSuccess { get; set; }

    [Parameter]
    public EventCallback<string> OnAuthFailed { get; set; }

    private enum AuthState
    {
        Initial,
        Starting,
        WaitingForUser,
        Success,
        Expired,
        Failed
    }

    private AuthState _state = AuthState.Initial;
    private HytaleDeviceCodeInfo? _deviceCode;
    private HytaleUserCredentials? _credentials;
    private string? _errorMessage;
    private bool _copiedUrl;
    private bool _copiedCode;
    private int _secondsRemaining;
    private double _progressPercent;
    private Guid? _userId;

    // Startup progress tracking
    private string _startupStatusMessage = "Initializing...";
    private int _startupElapsedSeconds;
    private System.Timers.Timer? _startupTimer;

    private System.Timers.Timer? _countdownTimer;
    private System.Timers.Timer? _pollTimer;
    private CancellationTokenSource? _pollCts;

    private string ModalTitle => _state switch
    {
        AuthState.Success => "Connected Successfully!",
        AuthState.Expired => "Code Expired",
        AuthState.Failed => "Authentication Failed",
        _ => "Connect Hytale Account"
    };

    private string CountdownClass
    {
        get
        {
            if (_secondsRemaining <= 60) return "countdown-timer danger";
            if (_secondsRemaining <= 180) return "countdown-timer warning";
            return "countdown-timer";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && _state == AuthState.Initial)
        {
            await StartAuthentication();
        }
        else if (!IsOpen)
        {
            ResetState();
        }
    }

    private async Task StartAuthentication()
    {
        _state = AuthState.Starting;
        _errorMessage = null;
        _startupElapsedSeconds = 0;
        _startupStatusMessage = "Initializing...";
        StateHasChanged();

        // Start a timer to show elapsed time during startup
        StartStartupTimer();

        try
        {
            // Get current user ID
            var authState = await AuthStateProvider.GetAuthenticationStateAsync().ConfigureAwait(false);
            var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier);
            if (userIdClaim == null || !Guid.TryParse(userIdClaim.Value, out var userId))
            {
                StopStartupTimer();
                _state = AuthState.Failed;
                _errorMessage = "Unable to determine current user.";
                return;
            }
            _userId = userId;

            // Update status
            _startupStatusMessage = "Contacting Hytale servers...";
            await InvokeAsync(StateHasChanged);

            // Start the OAuth flow (this is the slow part - can take 40+ seconds)
            var result = await AuthService.StartAuthenticationAsync(userId).ConfigureAwait(false);

            StopStartupTimer();

            if (!result.Success || result.DeviceCode == null)
            {
                _state = AuthState.Failed;
                _errorMessage = result.Error ?? "Failed to start authentication.";
                return;
            }

            _deviceCode = result.DeviceCode;
            _secondsRemaining = (int)(_deviceCode.ExpiresAt - DateTime.UtcNow).TotalSeconds;
            _progressPercent = 100;
            _state = AuthState.WaitingForUser;

            // Start countdown timer
            StartCountdownTimer();

            // Start polling for completion
            StartPolling();
        }
        catch (Exception ex)
        {
            StopStartupTimer();
            _state = AuthState.Failed;
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void StartStartupTimer()
    {
        StopStartupTimer();
        _startupTimer = new System.Timers.Timer(1000);
        _startupTimer.Elapsed += async (sender, e) =>
        {
            _startupElapsedSeconds++;

            // Update status message based on elapsed time
            _startupStatusMessage = GetStartupStatusMessage(_startupElapsedSeconds);

            await InvokeAsync(StateHasChanged);
        };
        _startupTimer.Start();
    }

    private void StopStartupTimer()
    {
        _startupTimer?.Stop();
        _startupTimer?.Dispose();
        _startupTimer = null;
    }

    private static string GetStartupStatusMessage(int elapsedSeconds)
    {
        if (elapsedSeconds < 5) return "Initializing...";
        if (elapsedSeconds < 15) return "Contacting Hytale servers...";
        if (elapsedSeconds < 30) return "Waiting for device code...";
        return "Almost there...";
    }

    private void StartCountdownTimer()
    {
        StopCountdownTimer();

        _countdownTimer = new System.Timers.Timer(1000);
        _countdownTimer.Elapsed += async (sender, e) =>
        {
            _secondsRemaining--;

            if (_deviceCode != null)
            {
                var totalSeconds = (_deviceCode.ExpiresAt - DateTime.UtcNow.AddSeconds(_secondsRemaining)).TotalSeconds;
                if (totalSeconds > 0)
                {
                    _progressPercent = (_secondsRemaining / totalSeconds) * 100;
                }
            }

            if (_secondsRemaining <= 0)
            {
                StopCountdownTimer();
                StopPolling();
                _state = AuthState.Expired;
            }

            await InvokeAsync(StateHasChanged);
        };
        _countdownTimer.Start();
    }

    private void StopCountdownTimer()
    {
        _countdownTimer?.Stop();
        _countdownTimer?.Dispose();
        _countdownTimer = null;
    }

    private void StartPolling()
    {
        StopPolling();

        _pollCts = new CancellationTokenSource();
        var ct = _pollCts.Token;
        var pollInterval = _deviceCode?.PollingIntervalSeconds ?? 5;

        _pollTimer = new System.Timers.Timer(pollInterval * 1000);
        _pollTimer.Elapsed += async (sender, e) =>
        {
            if (ct.IsCancellationRequested || _userId == null) return;

            try
            {
                var result = await AuthService.PollAuthenticationAsync(_userId.Value, ct).ConfigureAwait(false);

                switch (result.Status)
                {
                    case HytaleAuthPollStatus.Success:
                        StopPolling();
                        StopCountdownTimer();
                        _credentials = result.Credentials;
                        _state = AuthState.Success;
                        await InvokeAsync(StateHasChanged);
                        break;

                    case HytaleAuthPollStatus.Expired:
                        StopPolling();
                        StopCountdownTimer();
                        _state = AuthState.Expired;
                        await InvokeAsync(StateHasChanged);
                        break;

                    case HytaleAuthPollStatus.Failed:
                        StopPolling();
                        StopCountdownTimer();
                        _state = AuthState.Failed;
                        _errorMessage = result.Error ?? "Authentication failed.";
                        await InvokeAsync(StateHasChanged);
                        break;

                    // Pending - continue polling
                }
            }
            catch (OperationCanceledException)
            {
                // Expected on cancellation
            }
            catch (Exception ex)
            {
                StopPolling();
                _state = AuthState.Failed;
                _errorMessage = $"Polling error: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }
        };
        _pollTimer.Start();
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;

        _pollTimer?.Stop();
        _pollTimer?.Dispose();
        _pollTimer = null;
    }

    private async Task CopyUrl()
    {
        if (_deviceCode?.VerificationUrl != null)
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _deviceCode.VerificationUrl);
            _copiedUrl = true;
            StateHasChanged();

            await Task.Delay(2000);
            _copiedUrl = false;
            StateHasChanged();
        }
    }

    private async Task CopyCode()
    {
        if (_deviceCode?.UserCode != null)
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _deviceCode.UserCode);
            _copiedCode = true;
            StateHasChanged();

            await Task.Delay(2000);
            _copiedCode = false;
            StateHasChanged();
        }
    }

    private async Task OpenUrl()
    {
        if (_deviceCode?.VerificationUrl != null)
        {
            await JSRuntime.InvokeVoidAsync("window.open", _deviceCode.VerificationUrl, "_blank", "noopener,noreferrer");
        }
    }

    private async Task Cancel()
    {
        if (_userId.HasValue)
        {
            await AuthService.CancelAuthenticationAsync(_userId.Value).ConfigureAwait(false);
        }

        StopPolling();
        StopCountdownTimer();
        await CloseModal();
    }

    private async Task ContinueAfterSuccess()
    {
        if (_credentials != null)
        {
            await OnAuthSuccess.InvokeAsync(_credentials);
        }
        await CloseModal();
    }

    private async Task CloseModal()
    {
        ResetState();
        await IsOpenChanged.InvokeAsync(false);
    }

    private void ResetState()
    {
        StopPolling();
        StopCountdownTimer();
        StopStartupTimer();
        _state = AuthState.Initial;
        _deviceCode = null;
        _credentials = null;
        _errorMessage = null;
        _copiedUrl = false;
        _copiedCode = false;
        _startupElapsedSeconds = 0;
        _startupStatusMessage = "Initializing...";
    }

    private string FormatTimeRemaining()
    {
        var minutes = _secondsRemaining / 60;
        var seconds = _secondsRemaining % 60;
        return $"{minutes:D2}:{seconds:D2}";
    }

    private string FormatTokenValidity()
    {
        if (_credentials == null) return "Unknown";

        var remaining = _credentials.TimeRemaining;
        if (remaining.TotalDays >= 1)
        {
            return $"{(int)remaining.TotalDays} days";
        }
        if (remaining.TotalHours >= 1)
        {
            return $"{(int)remaining.TotalHours} hours";
        }
        return $"{(int)remaining.TotalMinutes} minutes";
    }

    public void Dispose()
    {
        StopPolling();
        StopCountdownTimer();
        StopStartupTimer();
    }
}

@* CardHeader component for use inside Card *@
<div class="card-header">
    @if (!string.IsNullOrEmpty(Title))
    {
        <h3 class="text-base font-medium text-nebula-text-primary">@Title</h3>
    }
    @if (!string.IsNullOrEmpty(Subtitle))
    {
        <p class="text-sm text-nebula-text-muted mt-0.5">@Subtitle</p>
    }
    @if (Actions != null)
    {
        <div class="ml-auto">
            @Actions
        </div>
    }
    @ChildContent
</div>

@code {
    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}

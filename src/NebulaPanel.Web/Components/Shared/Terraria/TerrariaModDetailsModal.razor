@using NebulaPanel.Application.DTOs
@using NebulaPanel.Application.Services
@using NebulaPanel.Domain.Enums
@using NebulaPanel.Domain.Interfaces

<Modal IsOpen="@IsOpen"
       Size="ModalSize.Large"
       OnClose="HandleClose"
       ShowCloseButton="true"
       CloseOnBackdropClick="true"
       CloseOnEscape="true">
    <Header>
        <span class="text-lg font-medium text-nebula-text-primary">Mod Details</span>
    </Header>
    <Body>
        @if (Mod == null)
        {
            <div class="flex items-center justify-center py-12">
                <span class="text-nebula-text-muted">No mod selected</span>
            </div>
        }
        else if (_isLoading)
        {
            <div class="flex items-center justify-center py-12">
                <div class="flex flex-col items-center gap-3">
                    <div class="animate-spin rounded-full h-8 w-8 border-2 border-nebula-accent border-t-transparent"></div>
                    <span class="text-nebula-text-muted">Loading mod details...</span>
                </div>
            </div>
        }
        else if (_error != null)
        {
            <div class="bg-nebula-error/10 border border-nebula-error text-nebula-error rounded-nebula p-4">
                <div class="flex items-center gap-2">
                    <Icon Name="alert-circle" Size="IconSize.Small" />
                    <span>@_error</span>
                </div>
            </div>
        }
        else
        {
            <div class="mod-details-content">
                @* Header Section *@
                <div class="flex gap-4 mb-6">
                    @* Icon *@
                    <div class="w-24 h-24 flex-shrink-0">
                        @if (!string.IsNullOrEmpty(_details?.IconUrl))
                        {
                            <img src="@_details.IconUrl" alt="@_details.Name" class="w-full h-full object-cover rounded-lg" />
                        }
                        else
                        {
                            <div class="w-full h-full flex items-center justify-center bg-nebula-bg-tertiary rounded-lg">
                                <Icon Name="package" Size="IconSize.XLarge" Class="text-nebula-text-muted" />
                            </div>
                        }
                    </div>

                    @* Info *@
                    <div class="flex-1">
                        <h2 class="text-xl font-semibold text-nebula-text-primary mb-1">@(_details?.Name ?? Mod?.Name)</h2>

                        <div class="flex flex-wrap items-center gap-2 text-sm text-nebula-text-secondary mb-3">
                            @if (_details?.Authors.Count > 0)
                            {
                                <span>by @string.Join(", ", _details.Authors.Select(a => a.Name))</span>
                            }
                            else if (!string.IsNullOrEmpty(Mod?.Author))
                            {
                                <span>by @Mod.Author</span>
                            }
                        </div>

                        @* Stats *@
                        <div class="flex flex-wrap items-center gap-4 text-sm text-nebula-text-muted">
                            <span class="flex items-center gap-1">
                                <Icon Name="users" Size="IconSize.Small" />
                                @FormatNumber(_details?.Downloads ?? Mod?.Downloads ?? 0) subscribers
                            </span>
                            @if (_details?.UpdatedAt != null)
                            {
                                <span class="flex items-center gap-1">
                                    <Icon Name="clock" Size="IconSize.Small" />
                                    Updated @FormatRelativeDate(_details.UpdatedAt)
                                </span>
                            }
                            <span class="px-2 py-0.5 rounded-full text-xs font-medium bg-blue-500/20 text-blue-400">
                                Steam Workshop
                            </span>
                        </div>

                        @* Tags *@
                        @if (_details?.Categories.Count > 0)
                        {
                            <div class="flex flex-wrap gap-2 mt-3">
                                @foreach (var tag in _details.Categories.Take(5))
                                {
                                    <span class="px-2 py-0.5 text-xs rounded bg-nebula-bg-tertiary text-nebula-text-secondary">@tag</span>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* Description *@
                <div class="border-t border-nebula-border-subtle pt-4">
                    <h3 class="text-sm font-medium text-nebula-text-primary mb-3">Description</h3>
                    <div class="prose prose-invert max-w-none text-sm text-nebula-text-secondary max-h-64 overflow-y-auto">
                        @if (!string.IsNullOrEmpty(_details?.Description))
                        {
                            <p class="whitespace-pre-wrap">@_details.Description</p>
                        }
                        else if (!string.IsNullOrEmpty(_details?.Summary))
                        {
                            <p>@_details.Summary</p>
                        }
                        else
                        {
                            <p class="text-nebula-text-muted italic">No description available.</p>
                        }
                    </div>
                </div>
            </div>
        }
    </Body>
    <Footer>
        <div class="flex justify-end gap-3">
            <Button Variant="ButtonVariant.Secondary" Text="Close" OnClick="HandleClose" />
            @if (Mod != null)
            {
                <Button Variant="ButtonVariant.Primary"
                        Text="Install"
                        IconName="download"
                        OnClick="HandleInstall" />
            }
        </div>
    </Footer>
</Modal>

@code {
    /// <summary>
    /// The mod to display details for.
    /// </summary>
    [Parameter]
    public ModSearchItem? Mod { get; set; }

    /// <summary>
    /// Whether the modal is open.
    /// </summary>
    [Parameter]
    public bool IsOpen { get; set; }

    /// <summary>
    /// Callback when the modal is closed.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Callback when user clicks Install.
    /// </summary>
    [Parameter]
    public EventCallback<ModSearchItem> OnInstall { get; set; }

    [Inject]
    private ITerrariaModService ModService { get; set; } = default!;

    // State
    private ModDetails? _details;
    private bool _isLoading;
    private string? _error;
    private string? _lastLoadedModId;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && Mod != null && Mod.Id != _lastLoadedModId)
        {
            await LoadDetailsAsync();
        }
    }

    private async Task LoadDetailsAsync()
    {
        if (Mod == null) return;

        _isLoading = true;
        _error = null;
        _details = null;
        _lastLoadedModId = Mod.Id;
        StateHasChanged();

        try
        {
            _details = await ModService.GetModDetailsAsync(Mod.Id);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load mod details: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task HandleClose()
    {
        _lastLoadedModId = null;
        await OnClose.InvokeAsync();
    }

    private async Task HandleInstall()
    {
        if (Mod != null)
        {
            await OnInstall.InvokeAsync(Mod);
        }
    }

    private static string FormatNumber(long number) => number switch
    {
        >= 1_000_000 => $"{number / 1_000_000.0:F1}M",
        >= 1_000 => $"{number / 1_000.0:F1}K",
        _ => number.ToString("N0")
    };

    private static string FormatRelativeDate(DateTime date)
    {
        var diff = DateTime.UtcNow - date;
        var days = diff.TotalDays;
        if (days < 1) return "today";
        if (days < 2) return "yesterday";
        if (days < 7) return $"{(int)days}d ago";
        if (days < 30) return $"{(int)(days / 7)}w ago";
        if (days < 365) return $"{(int)(days / 30)}mo ago";
        return date.ToString("MMM yyyy");
    }
}

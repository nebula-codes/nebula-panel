@if (IsDivider)
{
    <div class="dropdown-divider"></div>
}
else
{
    <button type="button"
            class="@ComputedClasses"
            disabled="@Disabled"
            @onclick="HandleClick">
        @if (!string.IsNullOrEmpty(IconName))
        {
            <Icon Name="@IconName" Size="IconSize.Small" />
        }
        <span>@Text</span>
        @if (ChildContent != null)
        {
            @ChildContent
        }
    </button>
}

@code {
    [CascadingParameter]
    public Dropdown? ParentDropdown { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public string? IconName { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool IsDivider { get; set; }

    [Parameter]
    public bool Danger { get; set; }

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string ComputedClasses
    {
        get
        {
            var classes = new List<string>
            {
                "dropdown-item"
            };

            if (Danger)
                classes.Add("dropdown-item-danger");

            if (Disabled)
                classes.Add("opacity-50 cursor-not-allowed");

            if (!string.IsNullOrEmpty(Class))
                classes.Add(Class);

            return string.Join(" ", classes);
        }
    }

    private async Task HandleClick()
    {
        if (Disabled) return;

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }

        if (ParentDropdown != null)
        {
            await ParentDropdown.Close();
        }
    }
}

<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[*]NebulaPanel.Web.Components.*,[*]NebulaPanel.Infrastructure.Persistence.Migrations.*,[*]Program,[*.Tests]*,[*]System.Text.RegularExpressions.Generated*</Exclude>
          <ExcludeByFile>
            <!-- Exclude auto-generated files -->
            **/Migrations/*.cs
            **/obj/**/*.cs
          </ExcludeByFile>
          <ExcludeByAttribute>
            <!-- Exclude code marked with these attributes -->
            Obsolete
            GeneratedCodeAttribute
            CompilerGeneratedAttribute
            ExcludeFromCodeCoverageAttribute
          </ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
